{
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm lint",
            "timeout": 180,
            "statusMessage": "Running pnpm lint before PR…"
          }
        ]
      }
    ]
  }
}
