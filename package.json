{
  "private": true,
  "scripts": {
    "start": "pnpm --filter landing dev",
    "ship": "pnpm --filter landing run deploy",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new",
    "sync:secrets:local": "cd apps/landing && bash sync-secrets.sh local",
    "sync:secrets:production": "cd apps/landing && bash sync-secrets.sh production",
    "setup:install": "pnpm install",
    "setup:secrets": "pnpm run sync:secrets:local",
    "setup:supabase": "supabase start",
    "setup:syncfusion": "pnpm --filter review-app run sync",
    "setup": "pnpm run setup:install && pnpm run setup:secrets && pnpm run setup:supabase",
    "dev:review": "pnpm --filter review-app dev",
    "review:start": "pnpm --filter review-app dev",
    "ship:review": "pnpm --filter review-app deploy",
    "tail:review": "pnpm --filter review-app tail",
    "n8n": "bash artifacts/n8n-workflows/sync-n8n.sh",
    "n8n:list": "bash artifacts/n8n-workflows/sync-n8n.sh list",
    "n8n:pull-all": "bash artifacts/n8n-workflows/sync-n8n.sh pull-all",
    "n8n:push-all": "bash artifacts/n8n-workflows/sync-n8n.sh push-all",
    "dev:n8n-utils": "pnpm --filter n8n-utils dev",
    "ship:n8n-utils": "pnpm --filter n8n-utils deploy",
    "tail:n8n-utils": "pnpm --filter n8n-utils tail"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}