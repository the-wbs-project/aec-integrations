{
  "name": "aec-integrations",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "postinstall": "pnpm --filter @aeci/api --filter @aeci/web run cf-typegen",
    "prepare": "git config core.hooksPath .githooks || true",
    "sync:main": "git fetch origin main && git rebase origin/main",
    "dev": "pnpm dev:bound",
    "dev:conductor": "bash scripts/dev-conductor.sh",
    "dev:agent": "bash scripts/dev-launch.sh",
    "dev:landing": "pnpm --filter @aeci/landing dev",
    "dev:web": "pnpm --filter @aeci/web dev",
    "dev:api": "pnpm --filter @aeci/api dev",
    "dev:bound": "mkdir -p .wrangler/registry && WRANGLER_REGISTRY_PATH=$PWD/.wrangler/registry pnpm --parallel --filter @aeci/api --filter @aeci/web run dev:preview",
    "db:studio": "open http://localhost:54323 2>/dev/null || echo 'Supabase Studio: http://localhost:54323 (start the local stack first with: pnpm db:start)'",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --linked",
    "db:new": "supabase migration new",
    "db:list": "supabase migration list",
    "build": "pnpm -r --if-present run build",
    "build:web": "pnpm --filter @aeci/web build",
    "lint": "pnpm -r run lint && pnpm run format:check",
    "lint:fix": "pnpm -r run lint:fix && pnpm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:integration": "pnpm --filter @aeci/web run test:integration",
    "test:e2e": "pnpm --filter @aeci/web run test:e2e",
    "test:extras": "pnpm --filter @aeci/web run test:extras",
    "lighthouse": "pnpm --filter @aeci/web run lighthouse",
    "deploy:landing": "pnpm --filter @aeci/landing deploy",
    "deploy:web": "pnpm --filter @aeci/web deploy",
    "deploy:api": "pnpm --filter @aeci/api deploy",
    "tail:web": "pnpm --filter @aeci/web run tail",
    "tail:api": "pnpm --filter @aeci/api run tail",
    "tail:web:staging": "pnpm --filter @aeci/web run tail:staging",
    "tail:api:staging": "pnpm --filter @aeci/api run tail:staging",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "skills:update": "npx skills add coreyhaines31/marketingskills",
    "algolia:provision": "node scripts/algolia/provision.mjs",
    "algolia:apply-settings": "node scripts/algolia/apply-settings.mjs",
    "algolia:bulk-sync": "pnpm --filter @aeci/api db:algolia-bulk-sync"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "algoliasearch": "5.52.0",
    "angular-eslint": "^22.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "supabase": "^2.101.0",
    "typescript-eslint": "^8.61.0"
  }
}
