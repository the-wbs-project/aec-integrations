{
  "name": "aec-integrations",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @aeci/landing dev",
    "dev:landing": "pnpm --filter @aeci/landing dev",
    "dev:web": "pnpm --filter @aeci/web dev",
    "dev:api": "pnpm --filter @aeci/api dev",
    "dev:bound": "pnpm --parallel --filter @aeci/api --filter @aeci/web run dev:preview",
    "dev:stack-test": "pnpm --filter @aeci/stack-test dev",
    "dev:prisma-test": "pnpm --filter @aeci/prisma-test dev",
    "db:studio": "pnpm --filter @aeci/api prisma:studio",
    "build": "pnpm -r --if-present run build",
    "build:stack-test": "pnpm --filter @aeci/stack-test build",
    "build:web": "pnpm --filter @aeci/web build",
    "lint": "pnpm -r --if-present run lint",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test:unit": "pnpm -r --if-present run test:unit",
    "deploy:landing": "pnpm --filter @aeci/landing deploy",
    "deploy:web": "pnpm --filter @aeci/web deploy",
    "deploy:api": "pnpm --filter @aeci/api deploy",
    "deploy:stack-test": "pnpm --filter @aeci/stack-test deploy",
    "deploy:prisma-test": "pnpm --filter @aeci/prisma-test deploy",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "skills:update": "npx skills add coreyhaines31/marketingskills"
  }
}