{
  "name": "aec-integrations",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "postinstall": "pnpm --filter @aeci/api --filter @aeci/web run cf-typegen",
    "dev": "pnpm dev:bound",
    "dev:landing": "pnpm --filter @aeci/landing dev",
    "dev:web": "pnpm --filter @aeci/web dev",
    "dev:api": "pnpm --filter @aeci/api dev",
    "dev:bound": "pnpm --parallel --filter @aeci/api --filter @aeci/web run dev:preview",
    "db:studio": "pnpm --filter @aeci/api prisma:studio",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push --linked",
    "db:diff": "supabase db diff --linked --schema public",
    "db:new": "supabase migration new",
    "db:list": "supabase migration list",
    "db:pull": "pnpm --filter @aeci/api prisma:pull && pnpm --filter @aeci/api prisma:generate",
    "db:seed-from-staging": "bash scripts/seed-from-staging.sh",
    "db:seed-reference": "bash scripts/seed-reference-data.sh",
    "build": "pnpm -r --if-present run build",
    "build:web": "pnpm --filter @aeci/web build",
    "lint": "pnpm -r run lint && pnpm run format:check",
    "lint:fix": "pnpm -r run lint:fix && pnpm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "pnpm -r --if-present run test:unit",
    "test:integration": "pnpm --filter @aeci/web run test:integration",
    "test:e2e": "pnpm --filter @aeci/web run test:e2e",
    "test:extras": "pnpm --filter @aeci/web run test:extras",
    "lighthouse": "pnpm --filter @aeci/web run lighthouse",
    "deploy:landing": "pnpm --filter @aeci/landing deploy",
    "deploy:web": "pnpm --filter @aeci/web deploy",
    "deploy:api": "pnpm --filter @aeci/api deploy",
    "test:coverage": "pnpm -r --if-present run test:coverage",
    "skills:update": "npx skills add coreyhaines31/marketingskills"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "supabase": "^2.101.0",
    "typescript-eslint": "^8.59.3"
  }
}
