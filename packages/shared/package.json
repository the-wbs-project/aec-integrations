{
  "name": "@aeci/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared API contracts (TypeScript types + Zod schemas) for the AEC Integrations Workers. Workspace-only — not published.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "default": "./src/api/index.ts"
    },
    "./api/*": {
      "types": "./src/api/*.ts",
      "default": "./src/api/*.ts"
    },
    "./errors": {
      "types": "./src/errors/index.ts",
      "default": "./src/errors/index.ts"
    },
    "./errors/*": {
      "types": "./src/errors/*.ts",
      "default": "./src/errors/*.ts"
    },
    "./slug": {
      "types": "./src/slug.ts",
      "default": "./src/slug.ts"
    },
    "./audit-log": {
      "types": "./src/audit-log.ts",
      "default": "./src/audit-log.ts"
    },
    "./algolia": {
      "types": "./src/algolia.ts",
      "default": "./src/algolia.ts"
    },
    "./algolia-records": {
      "types": "./src/algolia-records.ts",
      "default": "./src/algolia-records.ts"
    },
    "./cache-purge": {
      "types": "./src/cache-purge.ts",
      "default": "./src/cache-purge.ts"
    },
    "./algolia-batch": {
      "types": "./src/algolia-batch.ts",
      "default": "./src/algolia-batch.ts"
    },
    "./datadog": {
      "types": "./src/datadog.ts",
      "default": "./src/datadog.ts"
    },
    "./timing-safe-equal": {
      "types": "./src/timing-safe-equal.ts",
      "default": "./src/timing-safe-equal.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
