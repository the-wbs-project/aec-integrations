# Copy this file to .dev.vars for local `wrangler dev`. .dev.vars is git-ignored.
# In deployed environments, set these via:
#   wrangler secret put DATABASE_URL --env preview|staging|production
#
# DATABASE_URL is read by the Worker at runtime (and by `prisma generate`).
# It is a Prisma Accelerate URL (HTTPS), not a direct Postgres connection.
DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=REPLACE_ME"

# DIRECT_URL is used ONLY by the Supabase CLI (`supabase db push / pull /
# diff`) and by `prisma generate` for schema introspection. The deployed
# Worker does NOT read this. It is the Supabase pooler URL.
# See docs/migrations.md for the migration workflow.
DIRECT_URL="postgresql://postgres:REPLACE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── Integration tests (AECI-48) ───────────────────────────────────────────
# Used by `pnpm test:integration`. Not bound to the deployed Worker — these
# only feed local/CI integration suites that talk to Supabase's PostgREST
# surface directly. Tests `describe.skipIf` themselves when any are unset.
#
# SUPABASE_URL: your project URL, e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# Public anon JWT (Supabase dashboard → Project Settings → API).
SUPABASE_ANON_KEY=
# Access token for a non-admin authenticated user. Refresh by signing in to
# the project from an incognito session and copying the access_token from
# the dashboard's auth.users row, or mint one via the Supabase admin API.
SUPABASE_TEST_USER_JWT=

# ─── Slug backfill integration test (AECI-53) ──────────────────────────────
# Direct Postgres URL used by `apps/api/src/integration/backfill-slugs.spec.ts`
# only. Points at a local Supabase dev DB or any throwaway Postgres with the
# schema migrations applied. The script under test (`scripts/backfill-slugs.ts`)
# uses the Accelerate-flavoured `DATABASE_URL` in production; the test bypasses
# Accelerate for speed. The test `describe.skipIf` itself when this is unset.
# Example: postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=

# ─── Local seeding from staging (AECI-80) ──────────────────────────────────
# Opt-in. Only required if you run `pnpm db:seed-from-staging` to pull
# staging's data shape into your local Postgres. Workers never read this —
# it is consumed only by `scripts/seed-from-staging.sh` from your shell
# (the script reads the variable from the environment, not from .dev.vars).
#
# Where to find it: Supabase Dashboard → `aeci-development` project →
# Project Settings → Database → Connection string → "URI" (use the
# "Transaction" / pooler form). Looks like:
#   postgresql://postgres:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Export it in your shell (.zshrc / .bashrc / direnv) — DO NOT paste it
# into .dev.vars, because the Worker has no use for it and shouldn't see
# raw Postgres credentials.
# DIRECT_URL_STAGING="postgresql://postgres:REPLACE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── Datadog (AECI-31) ─────────────────────────────────────────────────────
# DD_API_KEY is the only required secret for `logToDatadog()` (Datadog Logs
# HTTP intake). When empty, the helper is a no-op so dev boots cleanly.
DD_API_KEY=
# Optional. Datadog region host. Defaults to datadoghq.com when unset.
# Examples: datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com
DD_SITE=datadoghq.com
