# Copy this file to .dev.vars for local `wrangler dev`. .dev.vars is git-ignored.
# In deployed environments, set these via:
#   wrangler secret put DATABASE_URL --env preview|staging|production
#
# DATABASE_URL is read by the Worker at runtime (and by `prisma generate`).
# It is a Prisma Accelerate URL (HTTPS, prisma://), NOT a direct Postgres
# connection — the Worker uses @prisma/client/edge + withAccelerate() in EVERY
# tier, including local `wrangler dev`. A postgresql:// value here makes every
# query throw P6001 ("the URL must start with the protocol `prisma://`").
# Locally (Option 1, shared dev DB) use the SAME value as the GH Actions secret
# DATABASE_URL_STAGING — the `aeci-development` project's Accelerate URL, grabbed
# from the Prisma Console. See docs/environments.md → "Local dev: running the
# API Worker (Prisma Accelerate)".
DATABASE_URL="prisma://accelerate.prisma-data.net/?api_key=REPLACE_ME"

# DIRECT_URL is used ONLY by the Supabase CLI (`supabase db push / pull /
# diff`) and by `prisma generate` for schema introspection. The deployed
# Worker does NOT read this. It is the Supabase pooler URL.
# See docs/migrations.md for the migration workflow.
DIRECT_URL="postgresql://postgres:REPLACE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── Supabase URL + integration tests (AECI-48 / AECI-193) ──────────────────
# SUPABASE_URL is now ALSO read by the Worker at runtime (AECI-193): it drives
# JWKS user-JWT verification in `lib/user-auth.ts` (no DB round-trip). In
# deployed envs it's a wrangler `vars` entry (see wrangler.jsonc); locally,
# point it at the SHARED DEV project (https://dmbygwupskttzsvfzluq.supabase.co)
# so `pnpm dev:bound` verifies real tokens minted by the web mint script
# (apps/web/scripts/mint-dev-session.mjs).
#
# The integration suites (`pnpm test:integration`) read the same variable for
# PostgREST/RLS probes. For LOCAL-STACK RLS runs (supabase start), override
# per-invocation — shell-set vars beat `dotenv -e .dev.vars`:
#   SUPABASE_URL=http://127.0.0.1:54321 \
#   SUPABASE_ANON_KEY=<local anon> SUPABASE_SERVICE_ROLE_KEY=<local secret> \
#   pnpm test:integration
# NEVER run the service-role trigger specs (auth_user_delete_trigger) against
# the shared dev project — they create/delete auth users. Keep
# SUPABASE_SERVICE_ROLE_KEY empty here so they self-skip; supply it only in a
# local-stack override. Tests `describe.skipIf` themselves when vars are unset.
SUPABASE_URL=
# Publishable/anon key for the project SUPABASE_URL points at.
SUPABASE_ANON_KEY=
# Access token for a non-admin authenticated user. Mint a fresh one (1h
# expiry) with the kept dev tool:
#   cd apps/web && node --env-file=.dev.vars scripts/mint-dev-session.mjs
# Also consumed by the AECI-193 JWKS verification spec
# (src/integration/user-auth.jwks.spec.ts), which skips itself when unset or
# expired.
SUPABASE_TEST_USER_JWT=
# Service-role key. Required by the AECI-69 trigger test, which mints and
# deletes throwaway auth users via the Supabase admin API. Local Supabase
# exposes this as the "Secret" key (`pnpm exec supabase status`). Never
# commit a real value — the Worker has no use for the service role at
# runtime and shouldn't see it.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Slug backfill integration test (AECI-53) ──────────────────────────────
# Direct Postgres URL used by `apps/api/src/integration/backfill-slugs.spec.ts`
# only. Points at a local Supabase dev DB or any throwaway Postgres with the
# schema migrations applied. The script under test (`scripts/backfill-slugs.ts`)
# uses the Accelerate-flavoured `DATABASE_URL` in production; the test bypasses
# Accelerate for speed. The test `describe.skipIf` itself when this is unset.
# Example: postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=

# ─── Local seeding from staging (AECI-80) ──────────────────────────────────
# Opt-in. Only required if you run `pnpm db:seed-from-staging` to pull
# staging's data shape into your local Postgres. Workers never read this —
# it is consumed only by `scripts/seed-from-staging.sh` from your shell
# (the script reads the variable from the environment, not from .dev.vars).
#
# Where to find it: Supabase Dashboard → `aeci-development` project →
# Project Settings → Database → Connection string → "URI" (use the
# "Transaction" / pooler form). Looks like:
#   postgresql://postgres:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Export it in your shell (.zshrc / .bashrc / direnv) — DO NOT paste it
# into .dev.vars, because the Worker has no use for it and shouldn't see
# raw Postgres credentials.
# DIRECT_URL_STAGING="postgresql://postgres:REPLACE_ME@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── Airtable bulk migration (AECI-83) ─────────────────────────────────────
# Consumed ONLY by `scripts/airtable-to-supabase-bulk-migrate.ts` (one-time
# Airtable → Supabase migration). Workers never read these. The script writes
# to production Supabase via DIRECT_URL above using the privileged role — point
# DIRECT_URL at a SESSION-capable connection (Supabase "Session" pooler or the
# direct 5432 endpoint), because the script uses interactive transactions.
#
# AIRTABLE_PAT: a Personal Access Token with scopes data.records:read,
# data.records:write, and schema.bases:write on the base below (the script
# creates a `supabase_uuid` field and writes the rec-ID→UUID mapping back).
AIRTABLE_PAT=
# The Airtable base holding the curator workspace.
AIRTABLE_BASE_ID=appy81IdGJY6Fngf9

# ─── Review-app promotion push (POST /api/promote) ─────────────────────────
# Bearer token the review application presents to push promoted records into
# Supabase. The WORKER reads this at runtime (unlike the migration vars above),
# so set it as a Wrangler secret in deployed envs:
#   wrangler secret put REVIEW_APP_TOKEN --env preview|staging|production
# Generate a high-entropy value, e.g. `openssl rand -hex 32`. Absent → every
# /api/promote request is rejected 401 (fail-closed).
REVIEW_APP_TOKEN=

# ─── Cache-tag purge after promote (AECI-105 / ADR 0010) ───────────────────
# The promote handler purges the affected edge cache tags by calling Cloudflare's
# purge-by-tag API DIRECTLY (no web↔api service binding — see ADR 0010). The
# WORKER reads both at runtime, so set them as Wrangler secrets/vars in deployed
# envs (staging + production):
#   wrangler secret put CF_PURGE_API_TOKEN --env staging|production
#   wrangler secret put CF_ZONE_ID         --env staging|production   # or a wrangler var
# CF_PURGE_API_TOKEN MUST be scoped to `Zone.Cache Purge` on aecintegrations.com
# only (docs/CACHE_STRATEGY.md §5) — same minimal scope as the web Worker's token.
# Absent (local `pnpm dev:bound`, PR previews) → promote skips the purge as a
# graceful no-op; pages fall back to the TTL (≤15 min).
CF_PURGE_API_TOKEN=
CF_ZONE_ID=

# ─── Datadog (AECI-31) ─────────────────────────────────────────────────────
# DD_API_KEY is the only required secret for `logToDatadog()` (Datadog Logs
# HTTP intake). When empty, the helper is a no-op so dev boots cleanly.
DD_API_KEY=
# Optional. Datadog region host. Defaults to datadoghq.com when unset.
# Examples: datadoghq.eu, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com
DD_SITE=datadoghq.com

# ─── Algolia (AECI-134) ────────────────────────────────────────────────────
# Optional until the sync pipeline lands (3.5/3.6) — the Worker reads neither at
# runtime yet, so leave empty for local dev. ALGOLIA_ADMIN_KEY is the per-env
# MANAGEMENT key (search + index-mutation ACLs, scoped to this env's indexes),
# NOT the app-wide root admin key. Provision real per-env values with
# `node scripts/algolia/provision.mjs` and push them with
# `wrangler secret put ALGOLIA_APP_ID/ALGOLIA_ADMIN_KEY --env <env>`.
ALGOLIA_APP_ID=
ALGOLIA_ADMIN_KEY=

# ─── Perspective API toxicity scoring (AECI-198) ───────────────────────────
# Google Perspective API key. The WORKER reads it at runtime to score review
# bodies on POST /api/reviews, so set it as a Wrangler secret in deployed envs:
#   wrangler secret put PERSPECTIVE_API_KEY --env staging|production
# Optional and FAIL-OPEN: absent (local dev, PR previews) → scoring is a silent
# no-op storing toxicity_score=null; an outage also stores null (logged warn).
# The score only flags the moderation queue — it never blocks a submission.
# Get one from https://developers.perspectiveapi.com (enable the Comment
# Analyzer API on a Google Cloud project, then create an API key).
PERSPECTIVE_API_KEY=
