{
  "name": "@aeci/api",
  "private": true,
  "scripts": {
    "dev": "pnpm prisma:generate && wrangler dev --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "dev:preview": "pnpm prisma:generate && wrangler dev --env preview --port 8787 --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "start": "pnpm dev",
    "deploy": "pnpm prisma:generate && wrangler deploy",
    "deploy:staging": "pnpm prisma:generate && wrangler deploy --env staging",
    "deploy:production": "pnpm prisma:generate && wrangler deploy --env production",
    "prisma:generate": "dotenv -e .dev.vars -- prisma generate",
    "prisma:pull": "dotenv -e .dev.vars -- prisma db pull --url=postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "prisma:studio": "dotenv -e .dev.vars -- prisma studio",
    "db:apply-rls": "docker exec -e PGPASSWORD=postgres -i supabase_db_aec-integrations psql -U supabase_admin -d postgres -v ON_ERROR_STOP=1 -f - < ../../docs/rls_policies.sql",
    "db:backfill-slugs": "dotenv -e .dev.vars -- tsx scripts/backfill-slugs.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "dotenv -e .dev.vars -- vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aeci/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@prisma/extension-accelerate": "^3.0.1",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260510.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.90.0"
  }
}
