{
  "name": "@aeci/api",
  "private": true,
  "scripts": {
    "dev": "pnpm prisma:generate && wrangler dev",
    "dev:preview": "pnpm prisma:generate && wrangler dev --env preview --port 8787",
    "start": "pnpm dev",
    "deploy": "pnpm prisma:generate && wrangler deploy",
    "deploy:staging": "pnpm prisma:generate && wrangler deploy --env staging",
    "deploy:production": "pnpm prisma:generate && wrangler deploy --env production",
    "prisma:generate": "dotenv -e .dev.vars -- prisma generate",
    "prisma:migrate:dev": "dotenv -e .dev.vars -- prisma migrate dev",
    "prisma:migrate:deploy": "dotenv -e .dev.vars -- prisma migrate deploy",
    "prisma:studio": "dotenv -e .dev.vars -- prisma studio",
    "db:apply-rls": "dotenv -e .dev.vars -- bash -c 'psql \"$DIRECT_URL\" -f ../../docs/rls_policies.sql'",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aeci/shared": "workspace:*",
    "@prisma/client": "^6.19.3",
    "@prisma/extension-accelerate": "^3.0.1",
    "hono": "^4.12.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260510.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.90.0"
  }
}
