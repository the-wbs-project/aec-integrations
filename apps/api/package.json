{
  "name": "@aeci/api",
  "private": true,
  "scripts": {
    "dev": "pnpm db:setup:local && wrangler dev --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "dev:preview": "pnpm db:setup:local && wrangler dev --env preview --port ${AECI_API_PORT:-8787} --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "start": "pnpm dev",
    "deploy": "wrangler deploy --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "deploy:staging": "wrangler deploy --env staging --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "deploy:production": "wrangler deploy --env production --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "tail": "wrangler tail --env production",
    "tail:staging": "wrangler tail --env staging",
    "tail:production": "wrangler tail --env production",
    "prisma:generate": "dotenv -e .dev.vars -- prisma generate",
    "prisma:pull": "dotenv -e .dev.vars -- prisma db pull --url=postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply aeci-app-preview --local",
    "db:seed:taxonomy:local": "wrangler d1 execute aeci-app-preview --local --file=seed/taxonomy.sql",
    "db:seed:catalog:local": "wrangler d1 execute aeci-app-preview --local --file=seed/catalog.sql",
    "db:seed:fixtures:local": "wrangler d1 execute aeci-app-preview --local --file=seed/phase2-fixtures.sql",
    "db:seed:local": "pnpm db:seed:taxonomy:local && pnpm db:seed:catalog:local && pnpm db:seed:fixtures:local",
    "db:setup:local": "pnpm db:migrate:local && pnpm db:seed:local",
    "db:export:catalog": "tsx scripts/export-catalog-to-d1.ts",
    "db:seed-reviews": "tsx scripts/seed-reviews.ts",
    "db:reconcile-counts": "tsx scripts/reconcile-product-counts.ts",
    "db:reconcile-algolia-drift": "tsx scripts/reconcile-algolia-drift.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "dotenv -e .dev.vars -- vitest run --config vitest.integration.config.ts",
    "test:integration:ci": "vitest run --config vitest.integration.config.ts --reporter=default --reporter=json --outputFile=integration-results.json",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aeci/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.12",
    "jose": "^6.2.3",
    "tldts": "^7.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260510.0",
    "@prisma/client": "^6.19.3",
    "@types/better-sqlite3": "^7.6.13",
    "@vitest/coverage-v8": "^3.2.4",
    "better-sqlite3": "^12.11.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.90.0"
  }
}
