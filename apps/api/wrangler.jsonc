      // AECI-563 / ADR 0021: the promote ingest Workflow (see the base-config note).
      "workflows": [
        {
          "name": "aeci-promote-production",
          "binding": "PROMOTE_WORKFLOW",
          "class_name": "PromoteWorkflow",
        },
      ],
      // ADR 0016 / AECI-252 + AECI-256. promote-to-prod CI applies migrations via
