            "queue": "aeci-stats-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-reconcile-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-data-quality-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-attestation-notify-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-vendor-snapshot-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-traffic-classify-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          // AECI-1503: 3 retries are safe because the Stripe sync converges. A retry
          // re-reads Stripe and changes only what still differs.
          {
            "queue": "aeci-stripe-reconcile-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-gsc-inspect-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          // AECI-1418: 5 retries (OWNERSHIP_SYNC_MAX_RETRIES in lib/ownership-sync.ts,
          // pinned by wrangler-ownership-sync.spec.ts). The consumer backs off with
          // `retry({ delaySeconds })`. No dead-letter queue, like every other queue
          // here: an exhausted message writes its ledger row and the backfill re-sends.
          {
            "queue": "aeci-ownership-sync-production",
            "max_batch_size": 1,
            "max_retries": 5,
            "max_concurrency": 1,
          },
        ],
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
  },
}
