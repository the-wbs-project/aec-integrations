{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeci-api",
  "account_id": "e62ec9d8012c3e0c225f8e4dbab76b79",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  // The API Worker is PRIVATE. It is reachable only via the SSR Worker's
  // `API` service binding (see `apps/web/wrangler.jsonc`). No `routes:` and
  // `workers_dev: false` for every published env so there is no public
  // ingress. Per docs/STAGE_1_SPEC.md §15.2 and docs/CICD_PLAN.md §4.2.
  //
  // Prisma Accelerate connects over HTTPS (no TCP), so Node-compat polyfills
  // are not required and intentionally not enabled on the API Worker.
  //
  // Secrets (set via `wrangler secret put`):
  //   DATABASE_URL — Prisma Accelerate URL (prisma://...) used by the Worker at runtime.
  //   DIRECT_URL  — Supabase pooler URL used ONLY by the Prisma CLI for
  //                 migrations (locally and in CI). Do not read it from
  //                 Worker code.
  //   DD_API_KEY  — Datadog Logs HTTP intake key (AECI-31). `logToDatadog()`
  //                 no-ops when this is unset, so non-DD envs are unaffected.
  //   CF_PURGE_API_TOKEN — Cloudflare API token `POST /api/promote` presents to
  //                 Cloudflare's purge-by-tag API after a commit (AECI-105). MUST
  //                 be scoped to `Zone.Cache Purge` on `aecintegrations.com` only
  //                 (docs/CACHE_STRATEGY.md §5) — the same minimal scope the web
  //                 Worker's token uses. Absent (with CF_ZONE_ID) → promote skips
  //                 the cache purge (graceful no-op).
  //   CF_ZONE_ID  — Cloudflare zone the purge targets. Public value; provision per
  //                 env alongside CF_PURGE_API_TOKEN.
  //   ALGOLIA_APP_ID    — Algolia app id (AECI-134). Shared across envs. Consumed at
  //                 runtime by the AECI-139 daily-sync cron + promote→index hook
  //                 (and the SSR search bootstrap). Pushed per env via `wrangler
  //                 secret put` in CI.
  //   ALGOLIA_ADMIN_KEY — per-env MANAGEMENT key (search + index-mutation ACLs,
  //                 scoped to this env's indexes; NOT the app-wide root admin key).
  //                 API/sync use only — never client-exposed. Provision per env via
  //                 `node scripts/algolia/provision.mjs`; see docs/CICD_PLAN.md §7.5.
  //                 Required on production (verify-worker-secrets.sh fails the deploy
  //                 if absent — AECI-139); absent on preview/local → the cron +
  //                 promote hook are a graceful no-op.
  //   ANTHROPIC_API_KEY — Anthropic API key for review toxicity scoring via Claude
  //                 Haiku (AECI-258, supersedes the sunsetting Perspective API of
  //                 AECI-198). Read at runtime by `scoreToxicity()` on POST
  //                 /api/reviews. Optional + fail-open: absent (local/preview) →
  //                 scoring is a silent no-op storing toxicity_score=null (emits no
  //                 metric); an outage stores null too. Never blocks a submission.
  //                 Set per env via `wrangler secret put ANTHROPIC_API_KEY --env
  //                 <env>` when ready (no CI gate). GDPR prerequisite: the
  //                 Messages API has no per-request no-store control, so the
  //                 Anthropic org behind a real key MUST have zero data retention
  //                 (ZDR) enabled or scored review bodies are retained ~30 days
  //                 outside the AUTH_AND_RLS.md §8 erasure boundary.
  //   LINEAR_API_KEY — Linear personal API key for the form→Linear pipeline
  //                 (AECI-211 / Phase 6.4). Presented raw in `Authorization` (no
  //                 `Bearer`). Optional + fail-open like ANTHROPIC_API_KEY: absent
  //                 → issue creation is a silent no-op and the request row sits open
  //                 for the §6.7 reconciliation sweep. Set per env via `wrangler
  //                 secret put LINEAR_API_KEY --env <env>` when ready (no CI gate).
  //
  // AECI-139: the API Worker also runs `scheduled` + `queue` handlers (daily
  // scheduled jobs). The cron `scheduled` handler does not work inline — it
  // enqueues a message onto the matching Cloudflare Queue, and the `queue`
  // consumer runs it (ADR 0013: cron→queue→consumer). Cron triggers AND the queue
  // producer/consumer bindings are registered ONLY on staging + production (see
  // each env's `triggers` + `queues` blocks) — NOT on the base config or preview,
  // so ephemeral PR-preview Workers carry no queues and run no daily jobs. The eight
  // queues (`aeci-algolia-{sync,drift}-{staging,production}` for AECI-139/140,
  // `aeci-stats-{staging,production}` for the AECI-178 home-stats job, and
  // `aeci-reconcile-{staging,production}` for the AECI-214 request→Linear
  // reconciliation sweep) are provisioned by an idempotent `wrangler queues create`
  // step in deploy.yml / promote-to-prod.yml before the Worker deploy. PREREQS:
  // Workers Paid plan, and the CI CLOUDFLARE_API_TOKEN must carry the Queues edit
  // permission. See ADR 0013 and docs/environments.md.
  //
  // AECI-105 / Option B: the promote handler purges edge-cache tags by calling
  // Cloudflare DIRECTLY over HTTPS — there is NO `WEB` service binding back to the
  // SSR Worker. The earlier web↔api cycle (api → web `POST /admin/purge`) was
  // removed because the purge is just a stateless Cloudflare REST call; the API now
  // holds its own scoped token. The SSR Worker's `POST /admin/purge` remains as the
  // manual/incident + CI surface. See docs/adr/0010-promote-purges-cloudflare-directly.md.
  // When CF_PURGE_API_TOKEN / CF_ZONE_ID are unset (local `pnpm dev:bound`, PR
  // previews) promote no-ops the purge — expected, not a bug.
  "workers_dev": false,
  // Smart Placement is intentionally NOT enabled. Prisma Accelerate is a
  // globally distributed HTTPS pool: this Worker always reaches the nearest
  // Accelerate edge, and Accelerate (not us) handles the edge-to-origin DB
  // routing. Smart Placement can't influence the slow leg, and shifting the
  // Worker away from users would only hurt cache-hit and short-query
  // latencies. If we ever add a single-region direct backend, reconsider.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "vars": {
    "ENV": "preview",
    "DD_SITE": "us5.datadoghq.com",
    // AECI-74: overridden at dev/deploy time via `wrangler --var COMMIT_SHA:<sha> --var DEPLOYED_AT:<iso>`.
    "COMMIT_SHA": "unknown",
    "DEPLOYED_AT": "1970-01-01T00:00:00.000Z",
    // AECI-193: Supabase project base URL (public) — see env comment in the
    // preview block. Base config mirrors preview (bare `wrangler dev`).
    "SUPABASE_URL": "https://dmbygwupskttzsvfzluq.supabase.co",
  },
  "dev": {
    "port": 8787,
  },
  // AECI-54: TAXONOMY_KV powers `GET /api/taxonomy` read-through caching with
  // a 5-minute TTL. Each environment has its own namespace so preview/staging
  // never poisons production. `preview_id` here wires `aeci-api-taxonomy-preview`
  // for unscoped `wrangler dev`; per-env blocks below override with each env's
  // own namespace ID. Handler at `src/routes/taxonomy.ts` falls back to a
  // direct Prisma query when the binding is absent, so this stays optional.
  "kv_namespaces": [
    {
      "binding": "TAXONOMY_KV",
      "id": "331fc1cfc6e0421b985442ac934748fa",
      "preview_id": "331fc1cfc6e0421b985442ac934748fa",
    },
  ],
  // ADR 0016 / AECI-252: the application database is Cloudflare D1, bound as `DB`
  // and reached via the Drizzle client factory `getDb(env)` (`src/db/client.ts`).
  // `wrangler dev` serves a LOCAL SQLite copy (in `.wrangler/state`) regardless of
  // `database_id`, so local dev works no matter what id is set here. The preview
  // database is now provisioned (AECI-256); the staging/production ids below are
  // still placeholders, created with `wrangler d1 create` and pasted in. Drizzle writes flat
  // migration SQL to `apps/api/migrations/` (drizzle.config.ts `out`), which is
  // wrangler's default `migrations_dir`, so `wrangler d1 migrations apply` finds
  // them with no `migrations_pattern` override.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aeci-app-preview",
      "database_id": "05618c5a-929d-404d-8204-1e565c52b9c2",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      "name": "aeci-api-preview",
      "workers_dev": false,
      // AECI-105: no CF purge credentials provisioned for preview. Promote's
      // cache purge therefore no-ops in preview / local dev — the documented
      // graceful-degradation path (Option B; see the top comment).
      "vars": {
        "ENV": "preview",
        "DD_SITE": "us5.datadoghq.com",
        // AECI-74: overridden at dev/deploy time via `wrangler --var COMMIT_SHA:<sha> --var DEPLOYED_AT:<iso>`.
        "COMMIT_SHA": "unknown",
        "DEPLOYED_AT": "1970-01-01T00:00:00.000Z",
        // AECI-193: Supabase base URL (public; dev project for preview/staging,
        // prod project for production). Drives JWKS user-JWT verification in
        // lib/user-auth.ts. The anon + service-role keys are deliberately ABSENT
        // on the API Worker — it verifies with public JWKS material only
        // (AUTH_AND_RLS.md §4).
        "SUPABASE_URL": "https://dmbygwupskttzsvfzluq.supabase.co",
      },
      "kv_namespaces": [
        {
          "binding": "TAXONOMY_KV",
          "id": "331fc1cfc6e0421b985442ac934748fa",
          "preview_id": "331fc1cfc6e0421b985442ac934748fa",
        },
      ],
      // ADR 0016 / AECI-252. `pnpm dev:bound` runs the API Worker with
      // `--env preview`, so this is the binding the bound local stack uses — a
      // LOCAL SQLite copy regardless of id; the real preview database is provisioned (AECI-256).
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aeci-app-preview",
          "database_id": "05618c5a-929d-404d-8204-1e565c52b9c2",
          "migrations_dir": "migrations",
        },
      ],
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
    "staging": {
      "name": "aeci-api-staging",
      "workers_dev": false,
      // AECI-105 / Option B: promote purges the edge cache by calling Cloudflare
      // directly (CF_PURGE_API_TOKEN + CF_ZONE_ID secrets) — no WEB binding.
      "vars": {
        "ENV": "staging",
        "DD_SITE": "us5.datadoghq.com",
        // AECI-74: overridden at deploy time via `wrangler --var COMMIT_SHA:<sha> --var DEPLOYED_AT:<iso>`.
        "COMMIT_SHA": "unknown",
        "DEPLOYED_AT": "1970-01-01T00:00:00.000Z",
        // AECI-193: Supabase base URL (public; dev project for preview/staging,
        // prod project for production). Drives JWKS user-JWT verification in
        // lib/user-auth.ts. The anon + service-role keys are deliberately ABSENT
        // on the API Worker — it verifies with public JWKS material only
        // (AUTH_AND_RLS.md §4).
        "SUPABASE_URL": "https://dmbygwupskttzsvfzluq.supabase.co",
      },
      "kv_namespaces": [
        {
          "binding": "TAXONOMY_KV",
          "id": "dcc927dc53be4fdb9b7c5279e4803539",
        },
      ],
      // ADR 0016 / AECI-252 + AECI-256. `database_id` is provisioned (AECI-256);
      // deploy CI applies migrations via
      // `wrangler d1 migrations apply aeci-app-staging --env staging --remote`.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aeci-app-staging",
          "database_id": "6cd91530-20f3-4264-b6ba-3b2bf611c2aa",
          "migrations_dir": "migrations",
        },
      ],
      // Scheduled crons, dispatched by `controller.cron` in `src/scheduled.ts`.
      // Staging + production only (base config / preview have no `triggers`, so PR
      // previews don't run them). 06:00 UTC (= 01:00 EST) — moderation-queue health
      // snapshot (AECI-206, inline gauge); 07:00 UTC (= 02:00 EST) — home-stats compute
      // (AECI-178, §10); 08:00 UTC (= 03:00 EST, US-East launch base) — incremental
      // Algolia sync (AECI-139); 09:00 UTC (= 04:00 EST) — index-drift
      // reconciliation (AECI-140, §23.1). The five-field "*/15 * * * *" runs every
      // 15 min — the request→Linear reconciliation sweep (AECI-214 / Phase 6.7), a
      // tight backstop that retries stuck vendor_requests. UTC is DST-unaware
      // (accepted). Strings MUST match the constants in `src/scheduled.ts`.
      "triggers": {
        "crons": ["0 6 * * *", "0 7 * * *", "0 8 * * *", "0 9 * * *", "*/15 * * * *"],
      },
      // ADR 0013: the cron `scheduled` handler enqueues onto these queues; the
      // `queue` consumer (same Worker) runs the job. `binding` is the producer
      // handle read in `src/scheduled.ts`; the consumer entries make this Worker
      // process the same queues. Batch size 1 (each job is a singleton); 3 retries
      // (jobs are idempotent — sync upserts, drift is read-only, stats upserts).
      // Queues must exist before deploy (idempotent `wrangler queues create` in
      // deploy.yml).
      "queues": {
        "producers": [
          { "queue": "aeci-algolia-sync-staging", "binding": "ALGOLIA_SYNC_QUEUE" },
          { "queue": "aeci-algolia-drift-staging", "binding": "ALGOLIA_DRIFT_QUEUE" },
          { "queue": "aeci-stats-staging", "binding": "STATS_QUEUE" },
          { "queue": "aeci-reconcile-staging", "binding": "RECONCILE_QUEUE" },
        ],
        "consumers": [
          {
            "queue": "aeci-algolia-sync-staging",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-algolia-drift-staging",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-stats-staging",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-reconcile-staging",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
        ],
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
    "production": {
      "name": "aeci-api-production",
      "workers_dev": false,
      // AECI-105 / Option B: promote purges the edge cache by calling Cloudflare
      // directly (CF_PURGE_API_TOKEN + CF_ZONE_ID secrets) — no WEB binding.
      "vars": {
        "ENV": "production",
        "DD_SITE": "us5.datadoghq.com",
        // AECI-74: overridden at deploy time via `wrangler --var COMMIT_SHA:<sha> --var DEPLOYED_AT:<iso>`.
        "COMMIT_SHA": "unknown",
        "DEPLOYED_AT": "1970-01-01T00:00:00.000Z",
        // AECI-193: Supabase base URL (public; dev project for preview/staging,
        // prod project for production). Drives JWKS user-JWT verification in
        // lib/user-auth.ts. The anon + service-role keys are deliberately ABSENT
        // on the API Worker — it verifies with public JWKS material only
        // (AUTH_AND_RLS.md §4).
        "SUPABASE_URL": "https://jgxebjufabtwkcgxjqvk.supabase.co",
        // AECI-236 (§20.2): canonical public origin the post-promote IndexNow
        // submission builds its URLs against. Public value. The IndexNow ping
        // stays a no-op until the `INDEXNOW_KEY` secret is also provisioned at
        // launch (alongside the web Worker's `ALLOW_INDEXING="true"`); set this to
        // the host the web Worker actually serves at launch (canonicals are
        // self-referential to the serving origin, ADR 0011). Not set on
        // preview/staging — those are Access-gated, non-indexed, so IndexNow
        // no-ops there regardless.
        "PUBLIC_SITE_URL": "https://aecintegrations.com",
      },
      "kv_namespaces": [
        {
          "binding": "TAXONOMY_KV",
          "id": "35d63b5b3c4b492c9d4e6f2041d60136",
        },
      ],
      // ADR 0016 / AECI-252 + AECI-256. `database_id` is provisioned (AECI-256);
      // promote-to-prod CI applies migrations via `wrangler d1 migrations apply
      // aeci-app-production --env production --remote`.
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aeci-app-production",
          "database_id": "74dedcd8-99ff-4033-b28d-4d918e4ecd00",
          "migrations_dir": "migrations",
        },
      ],
      // Scheduled crons (see staging note): 06:00 UTC (= 01:00 EST) moderation-queue
      // health snapshot (AECI-206); 07:00 UTC (= 02:00 EST) home-stats compute (AECI-178);
      // 08:00 UTC (= 03:00 EST) incremental Algolia sync (AECI-139); 09:00 UTC (= 04:00 EST)
      // index-drift reconciliation (AECI-140); "*/15 * * * *" every 15 min — request→Linear
      // reconciliation sweep (AECI-214 / Phase 6.7). Dispatched by `controller.cron`.
      "triggers": {
        "crons": ["0 6 * * *", "0 7 * * *", "0 8 * * *", "0 9 * * *", "*/15 * * * *"],
      },
      // ADR 0013 (see staging note): cron enqueues → `queue` consumer runs the job.
      "queues": {
        "producers": [
          { "queue": "aeci-algolia-sync-production", "binding": "ALGOLIA_SYNC_QUEUE" },
          { "queue": "aeci-algolia-drift-production", "binding": "ALGOLIA_DRIFT_QUEUE" },
          { "queue": "aeci-stats-production", "binding": "STATS_QUEUE" },
          { "queue": "aeci-reconcile-production", "binding": "RECONCILE_QUEUE" },
        ],
        "consumers": [
          {
            "queue": "aeci-algolia-sync-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-algolia-drift-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-stats-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
          {
            "queue": "aeci-reconcile-production",
            "max_batch_size": 1,
            "max_retries": 3,
            "max_concurrency": 1,
          },
        ],
      },
      "observability": {
        "logs": {
          "enabled": true,
          "invocation_logs": true,
        },
      },
    },
  },
}
