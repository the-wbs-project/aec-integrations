// Stage 1 baseline schema. Source of truth: docs/DATABASE_SCHEMA.md §3–§11.
// Table inventory (for AECI-29 RLS): docs/AUTH_AND_RLS.md + the GRANT/RLS
// migration supabase/migrations/20260602051513_rls_grants_and_policies.sql.
//
// Conventions:
// - snake_case at the DB layer via @map / @@map; PascalCase / camelCase in Prisma.
// - All `*_at` columns use timestamptz(6).
// - Enum-style fields are `String` + Postgres CHECK constraint (added in raw SQL
//   inside the migration; Prisma does not model CHECKs).
// - Partial indexes (`WHERE ... IS NOT NULL`) are added in raw SQL; Prisma's
//   @@index does not emit `WHERE` clauses.
// - `set_updated_at()` trigger function + per-table triggers added in raw SQL.
// - `public.profiles.id` shares the same UUID as the corresponding
//   `auth.users.id`. Lifecycle is kept in sync by triggers (not a cross-schema
//   FK): `handle_new_user()` creates the profile on auth signup, and
//   `handle_auth_user_delete()` removes it on auth delete. See AECI-69 and
//   docs/AUTH_AND_RLS.md "Auth -> public sync triggers".

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  // Single-schema: AECI-69 dropped the cross-schema FK
  // `public.profiles.id -> auth.users(id)` in favour of trigger-based sync,
  // so Prisma no longer needs to mirror the entire `auth.*` schema (which
  // forced ~500 lines of gotrue-owned models that churned on every Supabase
  // upgrade). Migrations are managed by Supabase CLI in `supabase/migrations/`;
  // see `docs/migrations.md`. Prisma is used here only to generate the typed
  // client — `prisma migrate` is not run against this repo (AECI-72).
  schemas   = ["public"]
}

// Retained from AECI-28; proves the per-request Accelerate path. Do not drop.
model HealthCheck {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("health_check")
  @@schema("public")
}

// =============================================================================
// Core entities (§4)
// =============================================================================

model Vendor {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String  @unique
  companyName   String  @map("company_name")
  description   String?
  website       String?
  headquarters  String?
  foundedYear   Int?    @map("founded_year")
  publicPrivate String? @map("public_private")
  parentCompany String? @map("parent_company")

  linkedinUrl   String? @map("linkedin_url")
  crunchbaseUrl String? @map("crunchbase_url")
  wikiUrl       String? @map("wiki_url")
  sourceUrl     String? @map("source_url")
  githubOrg     String? @map("github_org")
  phoneNumber   String? @map("phone_number")
  contactEmail  String? @map("contact_email")

  logoUrl String? @map("logo_url")

  verified        Boolean @default(false)
  promotionStatus String  @default("pending") @map("promotion_status")
  adminNotes      String? @map("admin_notes")

  vqsCredibility Decimal?  @map("vqs_credibility") @db.Decimal(4, 2)
  vqsMomentum    Decimal?  @map("vqs_momentum") @db.Decimal(4, 2)
  vqsFit         Decimal?  @map("vqs_fit") @db.Decimal(4, 2)
  vqsTotal       Decimal?  @map("vqs_total") @db.Decimal(4, 2)
  vqsComputedAt  DateTime? @map("vqs_computed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  productVendors    ProductVendor[]
  builtIntegrations Integration[]   @relation("IntegrationBuiltByVendor")
  pageViews         PageView[]
  profiles          Profile[]

  @@index([slug], map: "vendors_slug_idx")
  @@index([companyName], map: "vendors_company_name_idx")
  @@index([promotionStatus], map: "vendors_promotion_status_idx")
  @@index([verified], map: "vendors_verified_idx")
  @@index([updatedAt(sort: Desc)], map: "vendors_updated_at_idx")
  @@map("vendors")
  @@schema("public")
}

model Product {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug String @unique
  name String

  description               String?
  website                   String?
  toolIntegrationsUrl       String? @map("tool_integrations_url")
  apiDocsUrl                String? @map("api_docs_url")
  hasApiDocs                Boolean @default(false) @map("has_api_docs")
  toolIntegrationCheckNotes String? @map("tool_integration_check_notes")

  // Narrative content (§4.2): per-audience / per-phase "how teams use it" value,
  // slug-based {audiences,phases} blob; shape in API_CONTRACTS §5.1. Read whole,
  // never queried by point. Written by promote (AECI-172), read by detail
  // hydration (AECI-173); null-stubbed until then.
  usefulness Json? @map("usefulness")

  productRole String  @default("application") @map("product_role")
  logoUrl     String? @map("logo_url")

  // Denormalized aggregates (§11.2). Stage 1: recomputed at the app layer by
  // recomputeProductCounts() (src/lib/product-counts.ts) inside the write tx on
  // changes to integrations/reviews; review_count + rating_*_avg count only
  // status='approved' reviews. Reconciliation: findProductCountDrift /
  // scripts/reconcile-product-counts.ts. DB triggers deferred to Phase 2.
  integrationCount    Int      @default(0) @map("integration_count")
  reviewCount         Int      @default(0) @map("review_count")
  ratingOverallAvg    Decimal? @map("rating_overall_avg") @db.Decimal(3, 2)
  ratingOnboardingAvg Decimal? @map("rating_onboarding_avg") @db.Decimal(3, 2)

  researchStatus  String  @default("pending") @map("research_status")
  researchNotes   String? @map("research_notes")
  promotionStatus String  @default("pending") @map("promotion_status")

  priorityTier    String?   @map("priority_tier")
  priorityScore   Decimal?  @map("priority_score") @db.Decimal(5, 2)
  scoreComputedAt DateTime? @map("score_computed_at") @db.Timestamptz(6)

  googleTrendsIndex   Int?      @map("google_trends_index")
  searchVolumeMonthly Int?      @map("search_volume_monthly")
  searchCheckedAt     DateTime? @map("search_checked_at") @db.Timestamptz(6)

  redditMentions24mo Int?      @map("reddit_mentions_24mo")
  redditCheckedAt    DateTime? @map("reddit_checked_at") @db.Timestamptz(6)

  adminNotes String? @map("admin_notes")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  sourceIntegrations    Integration[]       @relation("IntegrationSource")
  targetIntegrations    Integration[]       @relation("IntegrationTarget")
  poweredIntegrations   Integration[]       @relation("IntegrationPoweredByProduct")
  productCategories     ProductCategory[]
  productAudiences      ProductAudience[]
  productPhases         ProductPhase[]
  productVendors        ProductVendor[]
  extensionsAsExtension ProductExtension[]  @relation("ProductExtensionAsExtension")
  extensionsAsHost      ProductExtension[]  @relation("ProductExtensionAsHost")
  reviews               Review[]
  pageViews             PageView[]

  @@index([slug], map: "products_slug_idx")
  @@index([name], map: "products_name_idx")
  @@index([promotionStatus], map: "products_promotion_status_idx")
  @@index([researchStatus], map: "products_research_status_idx")
  @@index([priorityTier], map: "products_priority_tier_idx")
  @@index([productRole], map: "products_product_role_idx")
  @@index([updatedAt(sort: Desc)], map: "products_updated_at_idx")
  @@map("products")
  @@schema("public")
}

model Integration {
  id   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String?

  sourceProductId String @map("source_product_id") @db.Uuid
  targetProductId String @map("target_product_id") @db.Uuid

  mechanismKind String? @map("mechanism_kind")
  mechanismName String? @map("mechanism_name")
  direction     String?

  builtByVendorId    String? @map("built_by_vendor_id") @db.Uuid
  poweredByProductId String? @map("powered_by_product_id") @db.Uuid

  description  String?
  listingUrl   String? @map("listing_url")
  docsUrl      String? @map("docs_url")
  website      String?
  mechanismUrl String? @map("mechanism_url")
  pricingModel String? @map("pricing_model")
  maturity     String?
  notes        String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  sourceProduct    Product  @relation("IntegrationSource", fields: [sourceProductId], references: [id], onDelete: Cascade)
  targetProduct    Product  @relation("IntegrationTarget", fields: [targetProductId], references: [id], onDelete: Cascade)
  builtByVendor    Vendor?  @relation("IntegrationBuiltByVendor", fields: [builtByVendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  poweredByProduct Product? @relation("IntegrationPoweredByProduct", fields: [poweredByProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([sourceProductId], map: "integrations_source_idx")
  @@index([targetProductId], map: "integrations_target_idx")
  @@index([mechanismKind], map: "integrations_mechanism_kind_idx")
  @@index([updatedAt(sort: Desc)], map: "integrations_updated_at_idx")
  // Partial indexes added in raw SQL:
  //   integrations_built_by_idx    (built_by_vendor_id)    WHERE built_by_vendor_id    IS NOT NULL
  //   integrations_powered_by_idx  (powered_by_product_id) WHERE powered_by_product_id IS NOT NULL
  @@map("integrations")
  @@schema("public")
}

// =============================================================================
// Taxonomy (§5)
// =============================================================================

model TaxonomyCategory {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  name         String
  description  String?
  displayOrder Int?     @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  productCategories ProductCategory[]

  @@index([slug], map: "taxonomy_categories_slug_idx")
  @@map("taxonomy_categories")
  @@schema("public")
}

model TaxonomyAudience {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  name         String
  description  String?
  displayOrder Int?     @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  productAudiences ProductAudience[]

  @@index([slug], map: "taxonomy_audiences_slug_idx")
  @@map("taxonomy_audiences")
  @@schema("public")
}

model TaxonomyPhase {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique
  name         String
  description  String?
  displayOrder Int?     @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  productPhases ProductPhase[]

  @@index([slug], map: "taxonomy_phases_slug_idx")
  @@map("taxonomy_phases")
  @@schema("public")
}

// =============================================================================
// Join tables (§6)
// =============================================================================

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  category TaxonomyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId], map: "product_categories_category_idx")
  @@map("product_categories")
  @@schema("public")
}

model ProductAudience {
  productId  String   @map("product_id") @db.Uuid
  audienceId String   @map("audience_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  audience TaxonomyAudience @relation(fields: [audienceId], references: [id], onDelete: Cascade)

  @@id([productId, audienceId])
  @@index([audienceId], map: "product_audiences_audience_idx")
  @@map("product_audiences")
  @@schema("public")
}

model ProductPhase {
  productId String   @map("product_id") @db.Uuid
  phaseId   String   @map("phase_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  phase   TaxonomyPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@id([productId, phaseId])
  @@index([phaseId], map: "product_phases_phase_idx")
  @@map("product_phases")
  @@schema("public")
}

model ProductVendor {
  productId String   @map("product_id") @db.Uuid
  vendorId  String   @map("vendor_id") @db.Uuid
  isPrimary Boolean  @default(true) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  vendor  Vendor  @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@id([productId, vendorId])
  @@index([vendorId], map: "product_vendors_vendor_idx")
  @@map("product_vendors")
  @@schema("public")
}

model ProductExtension {
  productId     String   @map("product_id") @db.Uuid
  hostProductId String   @map("host_product_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product     Product @relation("ProductExtensionAsExtension", fields: [productId], references: [id], onDelete: Cascade)
  hostProduct Product @relation("ProductExtensionAsHost", fields: [hostProductId], references: [id], onDelete: Cascade)

  @@id([productId, hostProductId])
  @@index([hostProductId], map: "product_extensions_host_idx")
  @@map("product_extensions")
  @@schema("public")
}

// =============================================================================
// User and content (§7)
// =============================================================================

// `id` is the same UUID as the corresponding `auth.users.id`. Lifecycle is
// kept in sync by triggers (see AECI-69 and docs/AUTH_AND_RLS.md), not a
// cross-schema FK — so there is no Prisma relation field to `auth.users`
// here, and Worker code reaches gotrue via the Supabase admin API when it
// needs the auth-user shape.
model Profile {
  id                String  @id @db.Uuid
  displayName       String? @map("display_name")
  role              String  @default("reviewer")
  vendorId          String? @map("vendor_id") @db.Uuid
  workEmailVerified Boolean @default(false) @map("work_email_verified")
  trustTier         String  @default("standard") @map("trust_tier")
  themePreference   String  @default("system") @map("theme_preference")

  bannedAt  DateTime? @map("banned_at") @db.Timestamptz(6)
  banReason String?   @map("ban_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  vendor                 Vendor?              @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reviewsAuthored        Review[]             @relation("ReviewReviewer")
  reviewsModerated       Review[]             @relation("ReviewModerator")
  workflowsInitiated     WorkflowInstance[]
  workflowTransitions    WorkflowTransition[]
  auditLogEntries        AuditLog[]
  pageViews              PageView[]
  vendorRequestsResolved VendorRequest[]      @relation("VendorRequestResolver")

  @@index([role], map: "profiles_role_idx")
  // Partial indexes added in raw SQL:
  //   profiles_vendor_idx (vendor_id) WHERE vendor_id IS NOT NULL
  //   profiles_banned_idx (banned_at) WHERE banned_at IS NOT NULL
  @@map("profiles")
  @@schema("public")
}

model Review {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String  @map("product_id") @db.Uuid
  reviewerId String? @map("reviewer_id") @db.Uuid

  ratingOverall    Int @map("rating_overall") @db.SmallInt
  ratingOnboarding Int @map("rating_onboarding") @db.SmallInt

  title String
  body  String

  roleAtCompany  String? @map("role_at_company")
  yearsUsing     Int?    @map("years_using") @db.SmallInt
  wouldRecommend String? @map("would_recommend")

  status          String    @default("pending")
  rejectionReason String?   @map("rejection_reason")
  moderatedAt     DateTime? @map("moderated_at") @db.Timestamptz(6)
  moderatedBy     String?   @map("moderated_by") @db.Uuid
  toxicityScore   Int?      @map("toxicity_score") @db.SmallInt

  verifiedWorkEmail Boolean @default(false) @map("verified_work_email")
  locale            String  @default("en-US")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewer  Profile? @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  moderator Profile? @relation("ReviewModerator", fields: [moderatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([productId, status], map: "reviews_product_status_idx")
  @@index([status, createdAt(sort: Desc)], map: "reviews_status_created_idx")
  // Partial / conditional indexes added in raw SQL:
  //   reviews_reviewer_idx          (reviewer_id) WHERE reviewer_id IS NOT NULL
  //   reviews_unique_per_user_product UNIQUE (product_id, reviewer_id)
  //     WHERE reviewer_id IS NOT NULL AND status <> 'archived'
  @@map("reviews")
  @@schema("public")
}

// =============================================================================
// Operations and workflow (§8)
// =============================================================================

// Phase 2 Spec §5.1 shape. Loose polymorphic FK via (target_type, target_id);
// application-level validation lives in the Phase 6 form handler.
model VendorRequest {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind String

  targetType String @map("target_type")
  targetId   String @map("target_id") @db.Uuid

  submitterEmail String  @map("submitter_email")
  submitterName  String? @map("submitter_name")
  submitterRole  String? @map("submitter_role")

  domainMatch String @default("pending") @map("domain_match")

  body      String
  sourceUrl String? @map("source_url")

  status        String  @default("open")
  linearIssueId String? @map("linear_issue_id")

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedById String?   @map("resolved_by") @db.Uuid

  resolvedBy Profile? @relation("VendorRequestResolver", fields: [resolvedById], references: [id], onUpdate: NoAction)

  @@index([status], map: "vendor_requests_status_idx")
  @@index([targetType, targetId], map: "vendor_requests_target_idx")
  @@index([createdAt(sort: Desc)], map: "vendor_requests_created_at_idx")
  @@map("vendor_requests")
  @@schema("public")
}

model WorkflowInstance {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowType String @map("workflow_type")
  // Polymorphic: FK target varies by workflowType; not enforced at DB level.
  entityId     String @map("entity_id") @db.Uuid

  currentState  String  @map("current_state")
  linearIssueId String? @map("linear_issue_id")

  initiatedBy  String?   @map("initiated_by") @db.Uuid
  initiatedAt  DateTime  @default(now()) @map("initiated_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  finalOutcome String?   @map("final_outcome")

  initiator   Profile?             @relation(fields: [initiatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  transitions WorkflowTransition[]

  @@index([workflowType, entityId], map: "workflow_instances_type_entity_idx")
  // Partial indexes added in raw SQL:
  //   workflow_instances_state_idx  (workflow_type, current_state) WHERE completed_at IS NULL
  //   workflow_instances_linear_idx (linear_issue_id)              WHERE linear_issue_id IS NOT NULL
  @@map("workflow_instances")
  @@schema("public")
}

model WorkflowTransition {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflowId String @map("workflow_id") @db.Uuid

  fromState String? @map("from_state")
  toState   String  @map("to_state")
  actorId   String? @map("actor_id") @db.Uuid
  reason    String?
  metadata  Json?   @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workflow WorkflowInstance @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  actor    Profile?         @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([workflowId, createdAt], map: "workflow_transitions_workflow_idx")
  @@map("workflow_transitions")
  @@schema("public")
}

model AuditLog {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  actorId   String? @map("actor_id") @db.Uuid
  actorType String  @map("actor_type")

  action     String
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id") @db.Uuid

  beforeState Json? @map("before_state") @db.JsonB
  afterState  Json? @map("after_state") @db.JsonB
  metadata    Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "audit_log_entity_idx")
  @@index([action, createdAt(sort: Desc)], map: "audit_log_action_idx")
  @@index([createdAt(sort: Desc)], map: "audit_log_created_at_idx")
  // Partial index added in raw SQL:
  //   audit_log_actor_idx (actor_id, created_at DESC) WHERE actor_id IS NOT NULL
  @@map("audit_log")
  @@schema("public")
}

// =============================================================================
// Analytics and caching (§9)
// =============================================================================

model PageView {
  id        BigInt  @id @default(autoincrement())
  path      String
  productId String? @map("product_id") @db.Uuid
  vendorId  String? @map("vendor_id") @db.Uuid
  userId    String? @map("user_id") @db.Uuid
  sessionId String? @map("session_id")
  referrer  String?

  cfCountry  String? @map("cf_country")
  cfColo     String? @map("cf_colo")
  cfAsn      Int?    @map("cf_asn")
  cfBotScore Int?    @map("cf_bot_score")

  userAgentHash String? @map("user_agent_hash")
  locale        String?

  profileRole String? @map("profile_role")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendor  Vendor?  @relation(fields: [vendorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user    Profile? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([path, createdAt], map: "page_views_path_idx")
  @@index([cfCountry, createdAt], map: "page_views_country_idx")
  // Partial indexes added in raw SQL:
  //   page_views_product_idx (product_id, created_at) WHERE product_id IS NOT NULL
  //   page_views_user_idx    (user_id,    created_at) WHERE user_id    IS NOT NULL
  @@map("page_views")
  @@schema("public")
}

model StatsCache {
  key        String   @id
  value      Json     @db.JsonB
  computedAt DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)

  @@map("stats_cache")
  @@schema("public")
}

// =============================================================================
// Future-ready (§10)
// =============================================================================

model Translation {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType String @map("entity_type")
  entityId   String @map("entity_id") @db.Uuid
  locale     String
  field      String
  value      String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([entityType, entityId, locale, field])
  @@index([entityType, entityId, locale], map: "translations_lookup_idx")
  @@map("translations")
  @@schema("public")
}

// =============================================================================
// Landing-page tables (pre-AECI, captured in 20260101000000_landing_baseline.sql)
// =============================================================================
//
// Written by `apps/landing/` directly via PostgREST. The Worker does not
// query these via Prisma — they're modeled here only so the drift check
// stays clean.

model Feedback {
  id         BigInt   @id @default(autoincrement())
  features   String?
  tools      String?
  email      String?
  subscribed Boolean  @default(false)
  country    String?
  city       String?
  region     String?
  timezone   String?
  referrer   String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("feedback")
  @@schema("public")
}

model MailingList {
  id             BigInt   @id @default(autoincrement())
  email          String   @unique
  country        String?
  city           String?
  region         String?
  timezone       String?
  asOrganization String?  @map("as_organization")
  asn            Int?
  metroCode      Int?     @map("metro_code")
  utmSource      String?  @map("utm_source")
  utmMedium      String?  @map("utm_medium")
  utmCampaign    String?  @map("utm_campaign")
  referrer       String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("mailing_list")
  @@schema("public")
}
