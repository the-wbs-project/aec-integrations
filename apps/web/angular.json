{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "pnpm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "web": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:service": {
          // v22 already defaults to `@Service`; pin it so a CLI default change
          // or a contributor can't silently regress to `@Injectable` (AECI-127).
          "injectable": false
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "en-US",
          "subPath": ""
        },
        "locales": {
          // Example for future locales — keep `LOCALES` in apps/web/src/server.ts in sync.
          // "es-ES": {
          //   "translation": "src/locale/messages.es-ES.xlf",
          //   "subPath": "es"
          // }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "polyfills": ["@angular/localize/init"],
            "localize": true,
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/styles.css"],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "security": {
              // Angular SSR SSRF guard — see `apps/web/src/server.ts` for the
              // rationale (AECI-42). `*.workers.dev` covers preview deploys
              // (`workers_dev: true`), `*.aecintegrations.com` covers future
              // `www.` / `staging.` subdomains.
              "allowedHosts": [
                "localhost",
                "127.0.0.1",
                "aecintegrations.com",
                "*.aecintegrations.com",
                "*.workers.dev"
              ]
            },
            "ssr": {
              "entry": "src/server.ts",
              "platform": "neutral"
            },
            // `util` (AECI-142): the browser-only `/search` Algolia chunk pulls
            // `instantsearch.js` → `qs` → `object-inspect`, whose Node entry does
            // a bare `require('util')`. The browser build stubs it via
            // object-inspect's `browser` field, but the SSR build
            // (`platform: neutral`) can't resolve a bare Node builtin, so it must
            // be external. Safe: the chunk is dynamically imported only inside
            // `afterNextRender` (browser), so the SSR Worker never loads it — and
            // even if it did, `nodejs_compat` provides `util` at runtime.
            "externalDependencies": ["cloudflare:workers", "util"],
            // AECI-237 — inline `*.md` imports as raw strings via esbuild's
            // `text` loader, so the legal-page content registry
            // (`src/app/legal/legal-content.ts`) can `import` the Markdown
            // sources in `src/content/legal/`. Applies to every `.md` import,
            // but only the legal content uses them. The matching ambient type
            // (`declare module '*.md'`) lives in `src/markdown.d.ts`.
            "loader": {
              ".md": "text"
            },
            "outputPath": "dist"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "web:build:production"
            },
            "development": {
              "buildTarget": "web:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "buildTarget": "web:build:development",
            "tsConfig": "tsconfig.component-spec.json",
            "include": ["src/**/*.component.spec.ts"],
            "isolate": true
          }
        }
      }
    }
  }
}
