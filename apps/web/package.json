{
  "name": "@aeci/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/server/server.mjs",
    "dev": "pnpm run build && wrangler dev",
    "dev:preview": "wrangler dev --env preview --port 8788",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run build && wrangler deploy --env production",
    "deploy:preview": "pnpm run build && wrangler deploy --env preview",
    "cf-typegen": "wrangler types",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:extras": "scripts/run-extra-tests.sh",
    "lighthouse": "lhci autorun",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aeci/shared": "workspace:*",
    "@angular/cdk": "^21.2.10",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/localize": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@angular/ssr": "^21.2.9",
    "@datadog/browser-rum": "^7.1.0",
    "@spartan-ng/brain": "0.0.1-alpha.689",
    "hono": "^4.12.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^21.2.9",
    "@angular/cli": "^21.2.9",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^3.2.4",
    "miniflare": "^4.20260510.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.90.0",
    "xhr2": "^0.2.1"
  }
}
