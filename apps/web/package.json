{
  "name": "@aeci/web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "og:home": "node scripts/render-home-og.mjs",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr": "node dist/server/server.mjs",
    "dev": "pnpm run build && wrangler dev --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "dev:preview": "wrangler dev --env preview --port ${AECI_WEB_PORT:-8788} --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "preview": "pnpm run build && wrangler dev",
    "deploy": "pnpm run deploy:production",
    "deploy:preview": "pnpm run build && wrangler deploy --env preview",
    "deploy:staging": "pnpm run build && wrangler deploy --env staging --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "deploy:demo": "pnpm run build && wrangler deploy --env demo --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "deploy:production": "pnpm run build && wrangler deploy --env production --var COMMIT_SHA:$(git rev-parse HEAD) --var DEPLOYED_AT:$(date -u +%Y-%m-%dT%H:%M:%S.000Z)",
    "tail": "wrangler tail --env production",
    "tail:staging": "wrangler tail --env staging",
    "tail:production": "wrangler tail --env production",
    "cf-typegen": "wrangler types",
    "test": "vitest",
    "test:unit": "vitest run && pnpm run test:component",
    "test:component": "ng test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:browserstack": "browserstack-node-sdk playwright test --config=playwright.browserstack.config.ts",
    "test:extras": "scripts/run-extra-tests.sh",
    "lighthouse": "lhci autorun --config=../../.lighthouserc.cjs",
    "lint": "eslint . && node scripts/check-logical-properties.mjs",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@aeci/shared": "workspace:*",
    "@angular/aria": "^22.0.0",
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/localize": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@datadog/browser-rum": "^7.1.0",
    "@spartan-ng/brain": "0.0.1-alpha.708",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.49.0",
    "algoliasearch": "^5.40.0",
    "hono": "^4.12.12",
    "instantsearch.js": "^4.79.0",
    "marked": "^18.0.5",
    "posthog-js": "^1.393.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@axe-core/playwright": "^4.10.2",
    "@lhci/cli": "^0.15.0",
    "@playwright/test": "^1.51.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "browserstack-node-sdk": "^1.59.0",
    "jsdom": "^28.1.0",
    "miniflare": "^4.20260510.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.90.0",
    "xhr2": "^0.2.1"
  }
}
