/**
 * Wrangler config for the AEC Integrations web app (SSR Worker).
 *
 * SSR Worker scaffolded in AECI-21. Hono handles `/api/*`; everything else
 * falls through to Angular SSR (`@angular/ssr`). `nodejs_compat` is required
 * for the SSR runtime (Node polyfills used by `@angular/ssr`); see
 * `CLAUDE.md` and `docs/CICD_PLAN.md` §4.1.
 *
 * The custom-domain route for production (`aecintegrations.com`) is declared
 * here but DNS has NOT been flipped yet — that is Phase 7 (AECI-?? cutover).
 * Until cutover, the route accepts the config; traffic still flows via
 * `*.workers.dev`. Preview deploys use `workers_dev` URLs per PR.
 *
 * The `services` bindings (`API`) call the private API Worker (`apps/api/`)
 * over Cloudflare's internal RPC fabric — the API has no public ingress.
 * See docs/STAGE_1_SPEC.md §6.2, §15.2 and docs/CICD_PLAN.md §4.2.
 *
 * Edge cache, KV, and cookie-stripping middleware land in subsequent
 * Phase 1 issues.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aec-web",
	"account_id": "e62ec9d8012c3e0c225f8e4dbab76b79",
	"main": "./dist/server/server.mjs",
	"compatibility_date": "2026-05-14",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"dev": {
		"port": 8788
	},
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/browser"
	},
	"env": {
		"preview": {
			"name": "aec-web",
			"workers_dev": true,
			"vars": { "ENV": "preview" },
			"observability": { "enabled": true },
			"services": [
				{ "binding": "API", "service": "aeci-api-preview" }
			]
		},
		"production": {
			"name": "aec-web",
			"vars": { "ENV": "production" },
			"observability": { "enabled": true },
			"routes": [
				{
					"pattern": "aecintegrations.com",
					"custom_domain": true
				}
			],
			"services": [
				{ "binding": "API", "service": "aeci-api-production" }
			]
		}
	}
}
