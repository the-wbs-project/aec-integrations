{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aec-web",
	"account_id": "e62ec9d8012c3e0c225f8e4dbab76b79",
	"main": "src/index.ts",
	"compatibility_date": "2026-04-07",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"dev": {
		"port": 8788
	},
	"env": {
		"production": {
			"name": "aec-web",
			"workers_dev": true
		}
	}
}
