/**
 * Wrangler config for the AEC Integrations web app (SSR Worker).
 *
 * SSR Worker scaffolded in AECI-21. Hono handles `/api/*`; everything else
 * falls through to Angular SSR (`@angular/ssr`). `nodejs_compat` is required
 * for the SSR runtime (Node polyfills used by `@angular/ssr`); see
 * `CLAUDE.md` and `docs/CICD_PLAN.md` §4.1.
 *
 * Tiers (promotion order): preview → staging → demo → production.
 *   - Web production serves `prod.aecintegrations.com` (the eventual home page;
 *     pre-launch, no-index until the apex cutover).
 *   - Web demo serves `demo.aecintegrations.com` (the public showcase tier).
 *   - The apex (`aecintegrations.com`) and `www.` remain served by the landing
 *     Worker (`apps/landing`) — we are not promoting the app to the apex yet.
 *   - Preview deploys use `workers_dev` URLs per PR; staging is
 *     `staging.aecintegrations.com`.
 * All tiers share ONE Supabase auth project (ADR 0017); per-environment
 * isolation is via Cloudflare Access, not project separation.
 *
 * The `services` bindings (`API`) call the private API Worker (`apps/api/`)
 * over Cloudflare's internal RPC fabric — the API has no public ingress.
 * See docs/STAGE_1_SPEC.md §6.2, §15.2 and docs/CICD_PLAN.md §4.2.
 *
 * Edge cache, KV, and cookie-stripping middleware land in subsequent
 * Phase 1 issues.
 *
 * Datadog (AECI-31) — secrets, NOT vars, so values stay out of git. Push per
 * env with `wrangler secret put <KEY> --env <preview|production>`:
 *   DD_APPLICATION_ID   client-exposed RUM application id (rendered into HTML)
 *   DD_CLIENT_TOKEN     client-exposed RUM client token   (rendered into HTML)
 *   DD_API_KEY          server-only; Datadog Logs HTTP intake
 *   DD_SITE             public; defaults to datadoghq.com when unset
 *
 * Cache-tag purge (AECI-56 / Phase 2.10):
 *   ADMIN_PURGE_TOKEN   secret; bearer the caller of POST /admin/purge presents
 *   CF_PURGE_API_TOKEN  secret; CF API token, scoped to Zone.Cache Purge on
 *                       aecintegrations.com ONLY (docs/CACHE_STRATEGY.md §5)
 *   CF_ZONE_ID          public var; CF zone the purge call targets
 *
 * Algolia search (AECI-134) — secrets, NOT vars (values stay out of git). Both
 * are client-exposed (rendered into HTML by injectAlgoliaBootstrap), but the
 * SEARCH key is query-only + index-scoped. The admin/management key is NEVER
 * set on this Worker (it would reach the browser):
 *   ALGOLIA_APP_ID      shared app id (rendered into HTML)
 *   ALGOLIA_SEARCH_KEY  per-env query-only search key (rendered into HTML)
 * Provision per env with `node scripts/algolia/provision.mjs`; see
 * docs/CICD_PLAN.md §7.5 and docs/environments.md §6/§8.
 *
 * Supabase auth (AECI-193 / Phase 5.2):
 *   SUPABASE_URL        public var — the SINGLE shared auth project across all
 *                       environments (ADR 0017); same value in every `vars` below
 *   SUPABASE_ANON_KEY   publishable/anon key. Secret (NOT a var) only to keep
 *                       values out of git — same convention as
 *                       ALGOLIA_SEARCH_KEY. CI pushes it after deploy
 *                       (warn-and-skip when the GH secret is absent this
 *                       phase; flips to REQUIRED in 5.5). The service-role
 *                       key is NEVER set on any Worker (AUTH_AND_RLS.md §3).
 *
 * Push secrets per env (`wrangler secret put`); set `CF_ZONE_ID` under the
 * per-env `vars` block once the production / preview zone IDs are known.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeci-web",
  "account_id": "e62ec9d8012c3e0c225f8e4dbab76b79",
  "main": "./dist/server/server.mjs",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "dev": {
    "port": 8788,
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/browser",
  },
  "env": {
    "preview": {
      "name": "aeci-web",
      "workers_dev": true,
      "observability": { "enabled": true },
      // COMMIT_SHA / DEPLOYED_AT are sentinels overridden by `wrangler deploy
      // --var` in CI (AECI-92 /_version, AECI-74 parity with apps/api).
      "vars": {
        "ENV": "preview",
        // Crawler-indexing gate (apps/web/src/server/robots-policy.ts).
        // FAIL-CLOSED — anything but "true" blocks indexing via the
        // X-Robots-Tag: noindex header (plus a sitemap-less robots.txt that
        // still allows crawling, so the noindex is actually seen and honored).
        // Pre-launch this stays "false" on EVERY env, including production —
        // demo.aecintegrations.com is gated by Cloudflare Access until launch
        // (ADR 0017) and must not be indexed yet either way. At public launch,
        // set the indexable env's value to "true". Do NOT key off ENV:
        // production is the pre-launch demo.
        "ALLOW_INDEXING": "false",
        "DD_SITE": "us5.datadoghq.com",
        "COMMIT_SHA": "unknown",
        "DEPLOYED_AT": "1970-01-01T00:00:00.000Z",
        // AECI-193 / ADR 0017: Supabase base URL (public). The SINGLE shared
        // auth project — identical across preview/staging/production. Pairs with
        // the CI-pushed SUPABASE_ANON_KEY secret — see the header comment.
        "SUPABASE_URL": "https://ktuhnlypztujpsseujzx.supabase.co",
        // AECI-239: PostHog ingestion host (public; US Cloud). The CSP
        // connect-src is pinned to the US hosts. The POSTHOG_KEY is a CI-pushed
        // secret (absent → analytics no-ops, fail-open).
        "POSTHOG_HOST": "https://us.i.posthog.com",
      },
      "services": [{ "binding": "API", "service": "aeci-api-preview" }],
    },
    "staging": {
      "name": "aeci-web-staging",
      "vars": {
        "ENV": "staging",
        // See the preview env's note. Staging is behind Access AND non-indexable.
        "ALLOW_INDEXING": "false",
        "DD_SITE": "us5.datadoghq.com",
        "COMMIT_SHA": "unknown",
        "DEPLOYED_AT": "1970-01-01T00:00:00.000Z",
        "SUPABASE_URL": "https://ktuhnlypztujpsseujzx.supabase.co",
        "POSTHOG_HOST": "https://us.i.posthog.com",
      },
      "observability": { "enabled": true },
      "routes": [
        {
          "pattern": "staging.aecintegrations.com",
          "custom_domain": true,
        },
      ],
      "services": [{ "binding": "API", "service": "aeci-api-staging" }],
    },
    "demo": {
      "name": "aeci-web-demo",
      "vars": {
        "ENV": "demo",
        // Public (NOT behind Access), pre-launch — no-index. Keep "false". See
        // the preview env's note; `indexingAllowed` keys off this, not `ENV`.
        "ALLOW_INDEXING": "false",
        "DD_SITE": "us5.datadoghq.com",
        "COMMIT_SHA": "unknown",
        "DEPLOYED_AT": "1970-01-01T00:00:00.000Z",
        // ADR 0017: the single shared auth project (same value in every env).
        "SUPABASE_URL": "https://ktuhnlypztujpsseujzx.supabase.co",
        "POSTHOG_HOST": "https://us.i.posthog.com",
      },
      "observability": { "enabled": true },
      // The public showcase tier. `custom_domain: true` makes wrangler reconcile
      // the demo.aecintegrations.com DNS record + cert on deploy — on the first
      // demo deploy it REASSIGNS that hostname off the old production Worker, so
      // deploy demo BEFORE re-deploying production onto prod.aecintegrations.com.
      "routes": [
        {
          "pattern": "demo.aecintegrations.com",
          "custom_domain": true,
        },
      ],
      "services": [{ "binding": "API", "service": "aeci-api-demo" }],
    },
    "production": {
      "name": "aeci-web-production",
      "vars": {
        "ENV": "production",
        // See the preview env's note. prod.aecintegrations.com is gated by
        // Cloudflare Access until launch (ADR 0017) and no-index — keep "false"
        // until the apex cutover (when the app takes over aecintegrations.com),
        // then flip to "true" to allow indexing.
        "ALLOW_INDEXING": "false",
        "DD_SITE": "us5.datadoghq.com",
        "COMMIT_SHA": "unknown",
        "DEPLOYED_AT": "1970-01-01T00:00:00.000Z",
        "SUPABASE_URL": "https://ktuhnlypztujpsseujzx.supabase.co",
        "POSTHOG_HOST": "https://us.i.posthog.com",
      },
      "observability": { "enabled": true },
      // Web prod serves prod.aecintegrations.com (the demo tier serves
      // demo.aecintegrations.com). The apex (aecintegrations.com) and www stay
      // on the landing Worker (apps/landing) until the apex cutover.
      // `custom_domain: true` makes wrangler reconcile the DNS record + cert on
      // the aecintegrations.com zone on deploy.
      "routes": [
        {
          "pattern": "prod.aecintegrations.com",
          "custom_domain": true,
        },
      ],
      "services": [{ "binding": "API", "service": "aeci-api-production" }],
    },
  },
}
