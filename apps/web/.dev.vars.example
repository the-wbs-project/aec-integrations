# Local dev secrets for @aec/web (SSR Worker). Copy to `.dev.vars` and fill in.
# `.dev.vars` is git-ignored at the repo root. For deployed Workers, push
# secrets via: wrangler secret put <KEY> --env <preview|production>

ENV=preview

# ─── Datadog (AECI-31) ─────────────────────────────────────────────────────
# DD_APPLICATION_ID + DD_CLIENT_TOKEN are explicitly client-exposed (rendered
# into the SSR HTML so @datadog/browser-rum can pick them up). Stored as
# secrets here only to keep values out of git — the SSR Worker inlines them
# into HTML so they reach the browser at hydration time.
# DD_API_KEY is server-only (Datadog Logs HTTP intake).
# All three no-op when empty, so dev boots cleanly without a Datadog account.
DD_APPLICATION_ID=
DD_CLIENT_TOKEN=
DD_API_KEY=
# Optional. Defaults to datadoghq.com. Use datadoghq.eu / us3.datadoghq.com /
# us5.datadoghq.com / ap1.datadoghq.com as appropriate for the DD region.
DD_SITE=datadoghq.com

# ─── Cache-tag purge (AECI-56) ─────────────────────────────────────────────
# ADMIN_PURGE_TOKEN: bearer the caller of POST /admin/purge must present.
#   Locally pick anything (e.g. `dev-admin-token`). In deployed envs push via
#   `wrangler secret put ADMIN_PURGE_TOKEN --env <preview|production>`.
# CF_PURGE_API_TOKEN: Cloudflare API token the purge handler uses to call
#   CF's purge-by-tag API. Must be scoped to `Zone.Cache Purge` on
#   `aecintegrations.com` ONLY (docs/CACHE_STRATEGY.md §5 line 109).
# CF_ZONE_ID: Cloudflare zone the purge call targets. Public; can move into
#   `wrangler.jsonc` `vars` per env once known.
# All three are optional locally — the endpoint will 401 / return
# `cf_credentials_missing` until configured. Don't commit real values.
ADMIN_PURGE_TOKEN=
CF_PURGE_API_TOKEN=
CF_ZONE_ID=

# ─── Algolia search (AECI-134) ─────────────────────────────────────────────
# ALGOLIA_APP_ID + ALGOLIA_SEARCH_KEY are explicitly client-exposed: the SSR
# Worker renders them into the HTML (window.__AECI_ALGOLIA__) so InstantSearch
# (3.9) can pick them up at hydration. The SEARCH key is query-only and scoped
# to this env's three indexes. Both no-op when empty (no script injected), so
# dev boots cleanly without an Algolia account.
# The Algolia ADMIN/management key is NEVER set on the web Worker — it would
# reach the browser. It lives only on the API Worker (apps/api/.dev.vars.example).
# Provision real per-env values with `node scripts/algolia/provision.mjs` and
# push them with `wrangler secret put ALGOLIA_APP_ID/ALGOLIA_SEARCH_KEY --env <env>`.
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=

# ─── Supabase auth (AECI-193 / Phase 5) ──────────────────────────────────────
# SUPABASE_URL + SUPABASE_ANON_KEY are read by the SSR Worker at runtime: they
# feed `createSupabaseServerClient` (src/server/auth/supabase-server-client.ts),
# the cookie-session factory behind /auth/*. The anon (publishable) key is not
# truly secret — it's stored as a secret only to keep values out of git (same
# convention as ALGOLIA_SEARCH_KEY). Both empty → auth surfaces return 503
# `auth_not_configured` and everything else works. For local dev use the shared
# dev project (https://dmbygwupskttzsvfzluq.supabase.co); fetch the key with
# `supabase projects api-keys --project-ref dmbygwupskttzsvfzluq`.
# The service-role key is NEVER set on any Worker (AUTH_AND_RLS.md §3).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Mint-script-only credentials (apps/web/scripts/mint-dev-session.mjs) — the
# shared-dev throwaway test user. NEVER a Worker binding; the Worker does not
# read these. Used to mint a real session cookie / bearer token for the
# /auth/whoami 200-path smoke. See docs/environments.md → "Local dev: Supabase
# auth (Phase 5)".
SUPABASE_TEST_USER_EMAIL=
SUPABASE_TEST_USER_PASSWORD=
