/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["node", "@angular/localize"]
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"],
  // `*.harness.ts` are test-only helpers (they import `vitest`); they are
  // consumed by spec files and type-checked transitively under the spec
  // tsconfigs, so they must stay out of the app build graph.
  "exclude": ["src/**/*.spec.ts", "src/**/*.harness.ts"]
}
