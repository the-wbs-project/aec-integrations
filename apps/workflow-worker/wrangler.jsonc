{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "prosspect-workflows",
	"account_id": "e62ec9d8012c3e0c225f8e4dbab76b79",
	"main": "server/index.ts",
	"compatibility_date": "2026-04-07",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"assets": {
		"directory": "./dist/browser",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"kv_namespaces": [
		{
			"binding": "KV_CACHE",
			"id": "d9d5317a144c420786d041b3b14d2d8c"
		}
	],
	"browser": {
		"binding": "BROWSER"
	},
	"workflows": [
		// Vendor workflows
		{
			"name": "prosspect-vendor-linkedin",
			"binding": "WF_VENDOR_LINKEDIN",
			"class_name": "VendorLinkedinWorkflow"
		},
		{
			"name": "prosspect-vendor-github",
			"binding": "WF_VENDOR_GITHUB",
			"class_name": "VendorGithubWorkflow"
		},
		{
			"name": "prosspect-vendor-company-size",
			"binding": "WF_VENDOR_COMPANY_SIZE",
			"class_name": "VendorCompanySizeWorkflow"
		},
		{
			"name": "prosspect-vendor-funding",
			"binding": "WF_VENDOR_FUNDING",
			"class_name": "VendorFundingWorkflow"
		},
		{
			"name": "prosspect-vendor-press",
			"binding": "WF_VENDOR_PRESS",
			"class_name": "VendorPressWorkflow"
		},
		{
			"name": "prosspect-vendor-blog-recency",
			"binding": "WF_VENDOR_BLOG_RECENCY",
			"class_name": "VendorBlogRecencyWorkflow"
		},
		{
			"name": "prosspect-vendor-score",
			"binding": "WF_VENDOR_SCORE",
			"class_name": "VendorScoreWorkflow"
		},
		{
			"name": "prosspect-vendor-orchestrator",
			"binding": "WF_VENDOR_ORCHESTRATOR",
			"class_name": "VendorOrchestratorWorkflow"
		},
		// Tool workflows
		{
			"name": "prosspect-tool-api-check",
			"binding": "WF_TOOL_API_CHECK",
			"class_name": "ToolApiCheckWorkflow"
		},
		{
			"name": "prosspect-tool-marketplace",
			"binding": "WF_TOOL_MARKETPLACE",
			"class_name": "ToolMarketplaceWorkflow"
		},
		{
			"name": "prosspect-tool-ipaas",
			"binding": "WF_TOOL_IPAAS",
			"class_name": "ToolIpaasWorkflow"
		},
		{
			"name": "prosspect-tool-reviews",
			"binding": "WF_TOOL_REVIEWS",
			"class_name": "ToolReviewsWorkflow"
		},
		{
			"name": "prosspect-tool-search-demand",
			"binding": "WF_TOOL_SEARCH_DEMAND",
			"class_name": "ToolSearchDemandWorkflow"
		},
		{
			"name": "prosspect-tool-reddit",
			"binding": "WF_TOOL_REDDIT",
			"class_name": "ToolRedditWorkflow"
		},
		{
			"name": "prosspect-tool-integration-count",
			"binding": "WF_TOOL_INTEGRATION_COUNT",
			"class_name": "ToolIntegrationCountWorkflow"
		},
		{
			"name": "prosspect-tool-score",
			"binding": "WF_TOOL_SCORE",
			"class_name": "ToolScoreWorkflow"
		},
		{
			"name": "prosspect-tool-orchestrator",
			"binding": "WF_TOOL_ORCHESTRATOR",
			"class_name": "ToolOrchestratorWorkflow"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["WorkflowRun"]
		},
		{
			// Drop the old DO — orchestration moved fully to Cloudflare Workflows.
			"tag": "v2",
			"deleted_classes": ["WorkflowRun"]
		}
	],
	"vars": {
		// Search provider for the SerpAPI custom tool. "serpapi" or "searchapi".
		"SEARCH_PROVIDER": "searchapi",
		// Search tool exposed to Claude. "web" = Anthropic built-in web_search; "serpapi" = our custom tool.
		"SEARCH_TOOL": "web",
		"AIRTABLE_BASE_ID": "appy81IdGJY6Fngf9",
		"AIRTABLE_TABLES": {
			"tools": "tbleVEZV0H5RigtHN",
			"vendors": "tbln8aZjwPI3Am4TF",
			"categories": "tbl0xEW7FPousftNs",
			"projectPhases": "tblkv9fmq2nUnjwE7",
			"disciplines": "tbl0pNJbWBiA080o7",
			"toolIntegrations": "tbl6PBPsGJuPcrZZi"
		},
		"DEFAULT_MODEL": "claude-haiku-4-5-20251001",
		"CF_ACCOUNT_ID": "e62ec9d8012c3e0c225f8e4dbab76b79",
		"AI_GATEWAY_ID": "aeci-cf-workflows"
	}
	// Secrets (set via `wrangler secret put`):
	//   CF_AI_GATEWAY_TOKEN – Cloudflare AI Gateway token (cf-aig-authorization).
	//                         With BYOK on the gateway, this is the only auth we send
	//                         and the Anthropic key is stored in the gateway itself.
	//   ANTHROPIC_API_KEY   – optional. Only set if BYOK is *not* configured on the
	//                         gateway; otherwise the SDK uses a placeholder.
	//   SERP_API_KEY        – SerpAPI key       (when SEARCH_PROVIDER=serpapi)
	//   SEARCHAPI_API_KEY   – SearchAPI.io key  (when SEARCH_PROVIDER=searchapi)
	//   AIRTABLE_TOKEN      – Airtable PAT with data.records:write scope
	//   GITHUB_TOKEN        – optional, raises GitHub REST rate limit for V02
}
