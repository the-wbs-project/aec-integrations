{
  "name": "review-app",
  "private": true,
  "scripts": {
    "sync": "rm -rf .angular && npx syncfusion-license activate",
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "version:stamp": "node scripts/write-version.mjs",
    "build": "pnpm run version:stamp && ng build",
    "dev": "pnpm run version:stamp && (ng build --watch & wrangler dev)",
    "deploy": "pnpm run version:stamp && ng build && wrangler deploy",
    "tail": "wrangler tail",
    "cf-typegen": "wrangler types --strict-vars false"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@cloudflare/puppeteer": "^1.0.0",
    "@supabase/supabase-js": "^2.105.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@syncfusion/ej2-angular-buttons": "^33.2.3",
    "@syncfusion/ej2-angular-dropdowns": "^33.2.3",
    "@syncfusion/ej2-angular-grids": "^33.2.3",
    "@syncfusion/ej2-angular-inputs": "^33.2.3",
    "@syncfusion/ej2-angular-navigations": "^33.2.3",
    "@syncfusion/ej2-angular-notifications": "^33.2.3",
    "@syncfusion/ej2-angular-popups": "^33.2.3",
    "@syncfusion/ej2-angular-splitbuttons": "^33.2.3",
    "@syncfusion/ej2-base": "^33.2.3",
    "@syncfusion/ej2-buttons": "^33.2.3",
    "@syncfusion/ej2-dropdowns": "^33.2.3",
    "@syncfusion/ej2-grids": "^33.2.3",
    "@syncfusion/ej2-inputs": "^33.2.3",
    "@syncfusion/ej2-lists": "^33.2.3",
    "@syncfusion/ej2-popups": "^33.2.3",
    "@syncfusion/ej2-splitbuttons": "^33.2.3",
    "agents": "^0.11.9",
    "fast-xml-parser": "^4.5.1",
    "hono": "^4.12.12",
    "jose": "^6.2.3",
    "lucide-angular": "^0.525.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.0",
    "zod": "^4.3.6",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
