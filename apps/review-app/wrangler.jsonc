{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aeci-review",
	"account_id": "e62ec9d8012c3e0c225f8e4dbab76b79",
	"main": "server/index.ts",
	"compatibility_date": "2026-04-07",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"placement": { "mode": "smart" },
	// Bundle .md files as raw text strings so MCP prompt modules and the
	// /api/playbooks route can import the canonical playbooks from /playbooks/
	// at build time.
	"rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],
	"routes": [
		{
			"pattern": "review.aecintegrations.com",
			"custom_domain": true
		}
	],
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": false
		}
	},
	"assets": {
		"directory": "./dist/browser",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application"
	},
	"kv_namespaces": [
		{
			"binding": "KV_CACHE",
			"id": "c6abf01955e84673812865d6fa0098e7"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "RUNS_HUB",
				"class_name": "RunsHub"
			},
			{
				"name": "MCP_OBJECT",
				"class_name": "AeciReviewMcp"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["RunsHub"]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": ["AeciReviewMcp"]
		}
	],
	"browser": {
		"binding": "BROWSER"
	},
	"ai_search_namespaces": [
		{
			"binding": "AECI_SEARCH",
			"namespace": "default",
			"remote": true
		}
	],
	"ai": {
		"binding": "AI"
	},
	"send_email": [
		{
			"name": "REPORT_EMAIL",
			"destination_address": "chrisw@thewbsproject.com"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "REPORTS_QUEUE",
				"queue": "aeci-review-reports"
			},
			{
				"binding": "VENDOR_AUTO_ENRICH_QUEUE",
				"queue": "aeci-vendor-auto-enrich"
			},
			{
				"binding": "PRODUCT_AUTO_ENRICH_QUEUE",
				"queue": "aeci-product-auto-enrich"
			},
			{
				"binding": "SNAPSHOTS_QUEUE",
				"queue": "aeci-review-snapshots"
			}
		],
		"consumers": [
			{
				"queue": "aeci-review-reports",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 2,
				"dead_letter_queue": "aeci-review-reports-dlq"
			},
			{
				"queue": "aeci-vendor-auto-enrich",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 2,
				"dead_letter_queue": "aeci-vendor-auto-enrich-dlq"
			},
			{
				"queue": "aeci-product-auto-enrich",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 2,
				"dead_letter_queue": "aeci-product-auto-enrich-dlq"
			},
			{
				"queue": "aeci-review-snapshots",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 2,
				"dead_letter_queue": "aeci-review-snapshots-dlq"
			}
		]
	},
	"triggers": {
		// Cron schedules dispatched in scheduled() by event.cron string match.
		//   "0 14 * * 1"   — Weekly cost report (Mondays 14:00 UTC) [disabled]
		//   "*/5 * * * *"  — Vendor auto-enrich (every 5 min, count=10, sonnet) [disabled]
		//   "*/12 * * * *" — Product auto-enrich (every 12 min, count=5, sonnet) [disabled]
		//   "0 0 * * *"    — Daily stats snapshot (midnight UTC)
		"crons": ["0 0 * * *"]
	},
	"workflows": [
		// Vendor workflows
		{
			"name": "aeci-vendor-github",
			"binding": "WF_VENDOR_GITHUB",
			"class_name": "VendorGithubWorkflow"
		},
		{
			"name": "aeci-vendor-funding",
			"binding": "WF_VENDOR_FUNDING",
			"class_name": "VendorFundingWorkflow"
		},
		{
			"name": "aeci-vendor-score",
			"binding": "WF_VENDOR_SCORE",
			"class_name": "VendorScoreWorkflow"
		},
		{
			"name": "aeci-vendor-orchestrator",
			"binding": "WF_VENDOR_ORCHESTRATOR",
			"class_name": "VendorOrchestratorWorkflow"
		},
		{
			"name": "aeci-vendor-overview",
			"binding": "WF_VENDOR_OVERVIEW",
			"class_name": "VendorOverviewWorkflow"
		},
		// Tool workflows
		{
			"name": "aeci-product-overview",
			"binding": "WF_PRODUCT_OVERVIEW",
			"class_name": "ProductOverviewWorkflow"
		},
		{
			"name": "aeci-product-api-check",
			"binding": "WF_PRODUCT_API_CHECK",
			"class_name": "ProductApiCheckWorkflow"
		},
		{
			"name": "aeci-product-marketplace",
			"binding": "WF_PRODUCT_MARKETPLACE",
			"class_name": "ProductMarketplaceWorkflow"
		},
		{
			"name": "aeci-product-ipaas",
			"binding": "WF_PRODUCT_IPAAS",
			"class_name": "ProductIpaasWorkflow"
		},
		{
			"name": "aeci-product-reviews",
			"binding": "WF_PRODUCT_REVIEWS",
			"class_name": "ProductReviewsWorkflow"
		},
		{
			"name": "aeci-product-search-demand",
			"binding": "WF_PRODUCT_SEARCH_DEMAND",
			"class_name": "ProductSearchDemandWorkflow"
		},
		{
			"name": "aeci-product-reddit",
			"binding": "WF_PRODUCT_REDDIT",
			"class_name": "ProductRedditWorkflow"
		},
		{
			"name": "aeci-product-score",
			"binding": "WF_PRODUCT_SCORE",
			"class_name": "ProductScoreWorkflow"
		},
		{
			"name": "aeci-product-orchestrator",
			"binding": "WF_PRODUCT_ORCHESTRATOR",
			"class_name": "ProductOrchestratorWorkflow"
		},
		{
			"name": "aeci-product-research",
			"binding": "WF_PRODUCT_RESEARCH",
			"class_name": "ProductResearchWorkflow"
		},
		// Integration discovery — sub-orchestrator + six per-source leaves.
		{
			"name": "aeci-product-integrations-website",
			"binding": "WF_INTEGRATIONS_WEBSITE",
			"class_name": "ProductIntegrationsWebsiteWorkflow"
		},
		{
			"name": "aeci-product-integrations-ipaas",
			"binding": "WF_INTEGRATIONS_IPAAS",
			"class_name": "ProductIntegrationsIpaasWorkflow"
		},
		{
			"name": "aeci-product-integrations-marketplaces",
			"binding": "WF_INTEGRATIONS_MARKETPLACES",
			"class_name": "ProductIntegrationsMarketplacesWorkflow"
		},
		{
			"name": "aeci-product-integrations-g2",
			"binding": "WF_INTEGRATIONS_G2",
			"class_name": "ProductIntegrationsG2Workflow"
		},
		{
			"name": "aeci-product-integrations-github",
			"binding": "WF_INTEGRATIONS_GITHUB",
			"class_name": "ProductIntegrationsGithubWorkflow"
		},
		{
			"name": "aeci-product-integrations-web",
			"binding": "WF_INTEGRATIONS_WEB",
			"class_name": "ProductIntegrationsWebWorkflow"
		},
		{
			"name": "aeci-product-integrations-discovery",
			"binding": "WF_INTEGRATIONS_DISCOVERY",
			"class_name": "ProductIntegrationsDiscoveryWorkflow"
		}
	],
	"vars": {
		// Search tool exposed to Claude.
		//   "searchapi" = our custom web_search tool backed by SearchAPI.io (default — cheap, compact results).
		//   "web"       = Anthropic built-in web_search_20250305 (fallback; auto-selected when SEARCHAPI_API_KEY is missing).
		"SEARCH_TOOL": "searchapi",
		"AIRTABLE_BASE_ID": "appy81IdGJY6Fngf9",
		"AIRTABLE_TABLES": {
			"products": "tbleVEZV0H5RigtHN",
			"vendors": "tbln8aZjwPI3Am4TF",
			"categories": "tbl0xEW7FPousftNs",
			"projectPhases": "tblkv9fmq2nUnjwE7",
			"disciplines": "tbl0pNJbWBiA080o7",
			"integrations": "tbl6PBPsGJuPcrZZi",
			"runs": "tbl0cslFyub1M9e9W",
			// `prompt_queue` table — drained by the scheduled Sonnet
			// dispatcher in the Claude macOS app. Schema lives in
			// services/promptQueue.ts; mutations only via MCP tools.
			"promptQueue": "tblCNxbwq9ezy4K6v",
			// `daily_stats` table — written by the SNAPSHOTS_QUEUE consumer
			// (cron 0 0 * * *). One row per UTC day. Schema lives in
			// services/snapshot/runDailySnapshot.ts.
			"dailyStats": "tbldgl3FsUzHNlvrw"
		},
		"DEFAULT_MODEL": "claude-haiku-4-5-20251001",
		"AI_GATEWAY_ID": "aeci-cf-workflows",
		"CF_ACCOUNT_ID": "e62ec9d8012c3e0c225f8e4dbab76b79",
		// Weekly cost report — addresses are configurable. REPORT_FROM must be
		// on a domain you've enabled Email Routing on in this Cloudflare account;
		// REPORT_TO must be a verified destination address (matches send_email
		// binding's destination_address above). REPORT_REPLY_TO is the human
		// inbox replies should land in (Gmail is fine here).
		"REPORT_FROM": "reports@aecintegrations.com",
		"REPORT_FROM_NAME": "AECi Cost Report",
		"REPORT_REPLY_TO": "aecintegrations@gmail.com",
		"REPORT_TO": "chrisw@thewbsproject.com",
		// USD cost per SearchAPI.io search, used by the weekly cost report.
		// String so it survives jsonc → env without precision loss; parsed as Number.
		"SEARCHAPI_COST_PER_SEARCH": "0.004",
		// Supabase auth — public values (anon key is gated by RLS, safe to ship).
		"SUPABASE_URL": "https://jgxebjufabtwkcgxjqvk.supabase.co",
		"SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImpneGVianVmYWJ0d2tjZ3hqcXZrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU3MjE5NTAsImV4cCI6MjA5MTI5Nzk1MH0.mH985-CGvr55NyTe8lNn9mLr_PXclPInrIYvSPv1gh0"
	}
	// Secrets (set via `wrangler secret put`):
	//   SEARCHAPI_API_KEY   – SearchAPI.io key. If unset the worker auto-falls back
	//                         to Anthropic web_search_20250305.
	//   AIRTABLE_TOKEN      – Airtable PAT with data.records:write scope
	//   GITHUB_TOKEN        – optional, raises GitHub REST rate limit for V02
	//   CF_API_TOKEN        – Cloudflare API token with `AI Gateway: Read` permission;
	//                         used by the weekly cost report to fetch gateway logs.
	//   SCRAPFLY_API_KEY    – Scrapfly anti-scraping proxy key. Used by vendor-overview
	//                         to fetch Crunchbase organization pages. Optional;
	//                         vendor-overview falls through to leaf workflows when unset.
	//   MCP_TOKEN           – Bearer token for the /mcp endpoint. Currently unused —
	//                         the MCP route is open. Set when re-enabling auth.
}
