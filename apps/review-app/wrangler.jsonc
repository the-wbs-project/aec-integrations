{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "aec-review-app",
	"account_id": "e62ec9d8012c3e0c225f8e4dbab76b79",
	"main": "server/index.ts",
	"compatibility_date": "2026-04-07",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	},
	"assets": {
		"directory": "./dist/browser",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "PLACEHOLDER_KV_ID"
		}
	],
	"vars": {
		"AIRTABLE_BASE_ID": "appy81IdGJY6Fngf9",
		"AIRTABLE_TABLES": {
			"tools": "tbleVEZV0H5RigtHN",
			"vendors": "tbln8aZjwPI3Am4TF",
			"categories": "tbl0xEW7FPousftNs",
			"projectPhases": "tblkv9fmq2nUnjwE7",
			"disciplines": "tbl0pNJbWBiA080o7",
			"toolIntegrations": "tbl6PBPsGJuPcrZZi"
		}
	}
}
