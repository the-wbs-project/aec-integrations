{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "landing-page",
  "account_id": "e62ec9d8012c3e0c225f8e4dbab76b79",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
  "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "landing-page" }],
  // Lead-capture forms persist to D1 via the API Worker (ADR 0016 / AECI-257).
  // Local dev / preview bind the `aeci-api-preview` Worker (the name it registers
  // under in the dev registry); production binds `aeci-api-production` below.
  "services": [{ "binding": "API", "service": "aeci-api-preview" }],
  "vars": {
    "NOTIFICATION_FROM": "notifications@aecintegrations.com",
    "NOTIFICATION_TO": "chrisw@thewbsproject.com",
  },
  "env": {
    "production": {
      "name": "landing-page",
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "landing-page" }],
      "services": [{ "binding": "API", "service": "aeci-api-production" }],
      "vars": {
        "NOTIFICATION_FROM": "notifications@aecintegrations.com",
        "NOTIFICATION_TO": "chrisw@thewbsproject.com",
      },
      "routes": [
        {
          "pattern": "www.aecintegrations.com",
          "custom_domain": true,
        },
        {
          "pattern": "aecintegrations.com",
          "custom_domain": true,
        },
      ],
    },
  },
}
