{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aeci-datatool",
  "account_id": "004dc1af737b22a8aa83b3550fa9b9d3",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-10",
  // INTERNAL ADMIN TOOL. Publishes to `aeci-datatool.thewbsproject.workers.dev`,
  // which is already inside the single `AECi Non-Prod` Cloudflare Access app's
  // `aeci-*.thewbsproject.workers.dev` destination (docs/access.md §1) — so it is
  // OTP-gated to the chrisw/billh allowlist with no new Access app/policy. The
  // Worker ALSO verifies the Access JWT in-process (src/access.ts) so a direct
  // origin hit can't bypass the edge gate. workers_dev:true is required for that
  // hostname to exist.
  //
  // This Worker binds all FOUR remote D1 databases at once (preview/staging/demo/
  // production — one per deploy tier, docs/environments.md) and can wipe-and-replace
  // any of them — see docs/access.md and the README. Deliberately NOT wired into CI
  // (deployed by hand like apps/landing).
  //
  // No `migrations_dir`: this Worker must NEVER run migrations — apps/api owns the
  // schema. No `nodejs_compat`: D1 is reached via the native bindings.
  //
  // The post-write cache purge is a Queue producer (WC-7 / AECI-321 — see the
  // `queues.producers` block below), NOT a zone HTTP purge: it enqueues onto the
  // target tier's `aeci-cache-purge-{env}` for that tier's SSR Worker to apply.
  //
  // Secrets (set via `wrangler secret put`; all graceful-skip if absent). The Algolia
  // pair is a SINGLE shared value — NOT per-env: one Algolia app whose admin key
  // reaches every `{env}_*` index (same value the apps/api + apps/web Workers get from
  // the un-suffixed ALGOLIA_* GitHub secret).
  //   ALGOLIA_APP_ID      — Algolia app id (post-write reindex)
  //   ALGOLIA_ADMIN_KEY   — Algolia management key (addObject/deleteObject)
  //   TOOL_TOKEN          — optional bearer fallback for curl/CI auth
  // (The datatool reads no CF purge token/zone: post-write purge enqueues onto the
  //  per-tier aeci-cache-purge-{env} queue since WC-7; CF_PURGE_API_TOKEN / CF_ZONE_ID
  //  were retired in WC-10.)
  "workers_dev": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "vars": {
    "ENV": "tool",
    // AECI-74 convention: overridden at dev/deploy time via
    // `wrangler --var COMMIT_SHA:<sha> --var DEPLOYED_AT:<iso>`.
    "COMMIT_SHA": "unknown",
    "DEPLOYED_AT": "1970-01-01T00:00:00.000Z",
    // Cloudflare Access application AUD (docs/access.md §1 — `AECi Non-Prod`).
    // Public value; the in-Worker JWT check verifies the Cf-Access-Jwt-Assertion
    // header carries this `aud`.
    "ACCESS_AUD": "cccc1e20ad7d9da26dd5a7fe67716b39102bc74e4eceb9eab66afb5786d7b632",
    // Cloudflare Zero-Trust team domain that issues/serves the Access JWKS at
    // `https://<team>.cloudflareaccess.com/cdn-cgi/access/certs`. This is the
    // `AEC Integrations` Zero Trust org (docs/access.md §1); the in-Worker
    // Access-JWT check (src/access.ts) verifies the Cf-Access-Jwt-Assertion
    // header's `iss` against `https://<this>` and its `aud` against ACCESS_AUD.
    "ACCESS_TEAM_DOMAIN": "the-wbs-project.cloudflareaccess.com",
  },
  "d1_databases": [
    {
      "binding": "DB_PREVIEW",
      "database_name": "aeci-app-preview",
      "database_id": "40b2021f-9023-4f4a-affb-9d2c657bb7e3",
    },
    {
      "binding": "DB_STAGING",
      "database_name": "aeci-app-staging",
      "database_id": "f4f80b55-d8e0-47fd-8277-e1879fe56a44",
    },
    {
      "binding": "DB_DEMO",
      "database_name": "aeci-app-demo",
      "database_id": "3600401b-0414-40f6-9c86-5cf4dfd8469d",
    },
    {
      "binding": "DB_PRODUCTION",
      "database_name": "aeci-app-production",
      "database_id": "1f4378db-dabb-4724-b5b8-d0a9ab6c6a3b", // AECI-839: ENAM copy, Cloudflare name aeci-app-production-us
    },
  ],
  // WC-7 (AECI-321): cross-Worker cache-purge producers. Producer-only — after a
  // copy/seed/reindex the datatool enqueues a `{ purgeEverything: true, source:
  // 'datatool' }` message onto the TARGET tier's queue; the SSR Worker for that tier
  // consumes `aeci-cache-purge-{env}` (apps/web/wrangler.jsonc) and applies
  // `ctx.cache.purge()`. Unlike apps/api/apps/web, this Worker has no `env.*` blocks,
  // so it binds all three cacheable tiers at once (one distinct binding each, mirroring
  // the four D1 bindings) and `targets.ts` picks the right one per request. There is
  // deliberately NO preview producer: preview is `*.workers.dev` with no edge cache and
  // no `aeci-cache-purge-preview` queue, so a preview target is a graceful no-op.
  // The queues are provisioned by the WC-5 deploy workflows (deploy.yml /
  // promote-to-demo.yml / promote-to-prod.yml); they must exist before this manual deploy.
  "queues": {
    "producers": [
      { "queue": "aeci-cache-purge-staging", "binding": "CACHE_PURGE_QUEUE_STAGING" },
      { "queue": "aeci-cache-purge-demo", "binding": "CACHE_PURGE_QUEUE_DEMO" },
      { "queue": "aeci-cache-purge-production", "binding": "CACHE_PURGE_QUEUE_PRODUCTION" },
    ],
  },
}
