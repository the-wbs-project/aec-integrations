# Local dev secrets for @aeci/prisma-test. Copy to `.dev.vars` and fill in.
# `.dev.vars` is git-ignored at the repo root. For deployed Workers, push
# secrets via: wrangler secret put <KEY>

# Prisma Accelerate URL (prisma://...). Runtime.
DATABASE_URL=

# Supabase pooler URL (postgresql://...). Used only by the Prisma CLI
# (`prisma generate`, ad-hoc `prisma db pull` against remote envs); Workers
# never read this. `prisma migrate` is not used in this repo — see
# docs/prisma.md.
DIRECT_URL=
