    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst parsed = raw.output || raw;\nconst context = $('Normalize Input').first().json;\nconst isApiDocs = parsed.has_api_docs === true && parsed.confidence !== 'low' && !!parsed.api_docs_url;\nreturn [{ json: {\n  record_id: context.record_id,\n  has_api_docs: isApiDocs,\n  api_docs_url: isApiDocs ? parsed.api_docs_url : null,\n  api_docs_checked_at: new Date().toISOString(),\n  status: 'success',\n  fields_updated: ['has_api_docs', 'api_docs_url', 'api_docs_checked_at'],\n  note: isApiDocs ? (parsed.notes || null) : (parsed.notes || 'No valid API docs found')\n} }];"
      },
