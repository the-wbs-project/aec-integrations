    {
      "parameters": {
        "jsCode": "const record = $input.first().json;\nconst fields = record.fields || record;\nconst tool_name = fields.Name || fields.name || null;\nconst website = fields.website || null;\nlet tool_domain = null;\nif (website) {\n  const match = website.match(/^(?:https?:\\/\\/)?([^\\/\\?#:]+)/i);\n  if (match && match[1] && match[1].includes('.')) {\n    tool_domain = match[1].replace(/^www\\./i, '').toLowerCase();\n  }\n}\nreturn {\n  record_id: record.id || $('Get Tool Record').first().json.id,\n  tool_name, website, tool_domain,\n  _has_required: !!(tool_name && tool_domain)\n};"
      },
