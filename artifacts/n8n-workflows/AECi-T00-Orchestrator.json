    {
      "parameters": {
        "jsCode": "// Compute tool_data_completeness from the actual re-fetched Airtable record.\n// The 10 enrichment signals from the plan:\n//   has_api_docs, marketplace_count, ipaas_count,\n//   g2_review_count, g2_rating, search_volume_monthly,\n//   google_trends_index, reddit_mentions_24mo,\n//   integration_count, + vendor outreach data available\n\nconst rec = $input.first().json;\nconst f = rec.fields || rec;\n\nconst signals = [\n  'has_api_docs',\n  'marketplace_count',\n  'ipaas_count',\n  'g2_review_count',\n  'g2_rating',\n  'search_volume_monthly',\n  'google_trends_index',\n  'reddit_mentions_24mo',\n  'integration_count'\n];\n\nlet populated = 0;\nfor (const s of signals) {\n  const v = f[s];\n  // Accept 0 and false as populated values (meaningful data)\n  if (v !== null && v !== undefined && v !== '') populated++;\n}\n\n// Vendor outreach availability: vendor linked AND at least one vendor field populated via lookup\nconst vendorAvailable =\n  (Array.isArray(f.vendors) && f.vendors.length > 0)\n  && (f.vendor_company_size || f.vendor_funding_stage || f.vendor_has_partner_program != null);\nif (vendorAvailable) populated++;\n\nconst completeness = populated / 10;\n\nlet status;\nif (completeness >= 0.75) status = 'enriched';\nelse if (completeness >= 0.40) status = 'partial';\nelse status = 'error';\n\nreturn [{ json: {\n  record_id: rec.id,\n  tool_data_completeness: Math.round(completeness * 100) / 100,\n  tool_enrichment_status: status,\n  last_tool_enriched_at: new Date().toISOString()\n} }];"
      },
