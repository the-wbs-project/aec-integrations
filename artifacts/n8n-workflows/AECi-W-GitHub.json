    {
      "parameters": {
        "jsCode": "const parsed = $input.first().json.output || $input.first().json;\nconst previous = $('Normalize Input').first().json;\n\nreturn {\n  ...previous,\n  candidate_slugs: parsed.candidate_slugs || [],\n  claude_confidence: parsed.confidence || 'low',\n  claude_reasoning: parsed.reasoning || ''\n};"
      },
