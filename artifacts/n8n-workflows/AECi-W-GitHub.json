      "parameters": {
        "jsCode": "const parsed = $input.first().json.output || $input.first().json;\nconst context = $('Normalize Input').first().json;\n\nconst slug = parsed.github_org_slug || null;\nconst confidence = parsed.confidence || 'low';\n\nreturn {\n  ...context,\n  github_org_slug: slug,\n  confidence,\n  _has_valid_org: !!(slug && confidence !== 'low')\n};"
      },
