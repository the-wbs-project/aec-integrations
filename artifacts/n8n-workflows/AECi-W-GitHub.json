      "id": "f86b8dae-1014-4c2f-8799-5e4c8a0d253e",
      "name": "GitHub: Check Org Exists",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -4832,
        896
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map(i => i.json);\nconst context = $('Normalize Input').first().json;\n\n// Filter to successful org lookups (status 200)\nconst found = items.filter(r => r.statusCode === 200 && r.data);\n\nif (found.length === 0) {\n  return { found: false, ...context };\n}\n\n// Pick the best match: prefer org whose blog/description mentions vendor domain\nconst domain = context.vendor_domain;\nlet best = found[0];\n\nif (domain && found.length > 1) {\n  const domainMatch = found.find(r => {\n    const org = r.data;\n    const desc = (org.description || '').toLowerCase();\n    const blog = (org.blog || '').toLowerCase();\n    return desc.includes(domain) || blog.includes(domain);\n  });\n  if (domainMatch) best = domainMatch;\n}\n\nconst org = best.data;\nreturn {\n  found: true,\n  ...context,\n  org_login: org.login,\n  org_description: org.description || null,\n  org_blog: org.blog || null\n};"
      },
      "id": "6aee885d-2d9e-4eb6-9dd1-87e0b0dfb23f",
      "name": "Pick Best Org",
