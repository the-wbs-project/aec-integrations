    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"linkedin_url\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"LinkedIn company page URL (https://www.linkedin.com/company/SLUG/), or null\"\n    },\n    \"linkedin_followers\": {\n      \"type\": [\"integer\", \"null\"],\n      \"description\": \"Follower count as a number (no commas), or null if not found\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\"high\", \"medium\", \"low\"],\n      \"description\": \"Confidence that this is the correct company page\"\n    }\n  },\n  \"required\": [\"linkedin_url\", \"linkedin_followers\", \"confidence\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        6968,
        3008
      ],
      "id": "a1b2c3d4-1001-4000-a000-000000000008",
      "name": "LinkedIn Data Parser"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst vendor = $('Get Vendor Record').first().json;\nconst parsed = raw.output || raw;\n\nconst linkedinUrl = parsed.linkedin_url || null;\nconst followers = (typeof parsed.linkedin_followers === 'number' && parsed.linkedin_followers >= 0)\n  ? parsed.linkedin_followers : null;\nconst low = parsed.confidence === 'low';\n\n// If confidence is low, discard the URL\nconst finalUrl = low ? null : linkedinUrl;\n\nconst fieldsUpdated = ['linkedin_checked_at'];\nif (finalUrl) fieldsUpdated.push('linkedin_url');\nif (followers !== null) fieldsUpdated.push('linkedin_followers');\n\nreturn {\n  record_id: vendor.id,\n  linkedin_url: finalUrl,\n  linkedin_followers: followers,\n  linkedin_checked_at: new Date().toISOString(),\n  status: finalUrl ? 'success' : 'partial',\n  fields_updated: fieldsUpdated,\n  note: !finalUrl ? 'No LinkedIn page found' : (followers === null ? 'URL found but no follower count in SERP' : null)\n};"
      },
