    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const record = $input.item.json;\nconst fields = record.fields || record;\n\nconst enrichmentFields = [\n  'github_org',\n  'linkedin_followers',\n  'company_size',\n  'funding_stage',\n  'press_count_12mo',\n  'blog_last_post_days_ago'\n];\n\nconst populated = enrichmentFields.filter(f => {\n  const v = fields[f];\n  return v !== null && v !== undefined && v !== '';\n}).length;\n\nconst completeness = populated / enrichmentFields.length;\n\nlet status;\nif (completeness >= 0.75) status = 'enriched';\nelse if (completeness >= 0.40) status = 'partial';\nelse status = 'error';\n\nreturn {\n  record_id: record.id,\n  vendor_data_completeness: completeness,\n  vendor_enrichment_status: status,\n  last_enriched_at: new Date().toISOString()\n};"
      },
