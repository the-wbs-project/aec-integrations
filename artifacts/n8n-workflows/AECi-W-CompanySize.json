    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"employee_range\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\"1-10\", \"11-50\", \"51-200\", \"201-1000\", \"1001-5000\", \"5000+\", null],\n      \"description\": \"Employee count bucket\"\n    },\n    \"employee_count_exact\": {\n      \"type\": [\"integer\", \"null\"],\n      \"description\": \"Exact employee count if known, or null\"\n    },\n    \"source\": {\n      \"type\": \"string\",\n      \"description\": \"Where the employee data came from (e.g. linkedin, crunchbase, website, wikipedia, glassdoor, unknown)\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\"high\", \"medium\", \"low\"],\n      \"description\": \"Confidence in the employee count\"\n    }\n  },\n  \"required\": [\"employee_range\", \"employee_count_exact\", \"source\", \"confidence\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1104,
        176
      ],
      "id": "55b0a9dc-c3c6-4bb1-96d9-ba94c19a1e1d",
      "name": "Employee Data Parser"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst vendor = $('Get Vendor Record').first().json;\nconst parsed = raw.output || raw;\n\nconst VALID_BUCKETS = ['1-10', '11-50', '51-200', '201-1000', '1001-5000', '5000+'];\n\nfunction exactToBucket(n) {\n  if (n <= 10) return '1-10';\n  if (n <= 50) return '11-50';\n  if (n <= 200) return '51-200';\n  if (n <= 1000) return '201-1000';\n  if (n <= 5000) return '1001-5000';\n  return '5000+';\n}\n\nlet range = parsed.employee_range || null;\nlet exact = (typeof parsed.employee_count_exact === 'number' && parsed.employee_count_exact > 0)\n  ? parsed.employee_count_exact : null;\nconst source = parsed.source || 'unknown';\nconst confidence = parsed.confidence || 'low';\n\n// If we have an exact count, derive the bucket from it (more reliable than LLM's bucket choice)\nif (exact) {\n  range = exactToBucket(exact);\n}\n\n// Validate bucket is one of our allowed values\nif (range && !VALID_BUCKETS.includes(range)) {\n  // Try to normalize common LinkedIn ranges\n  const map = {\n    '1-10': '1-10', '2-10': '1-10',\n    '11-50': '11-50',\n    '51-200': '51-200',\n    '201-500': '201-1000', '501-1000': '201-1000',\n    '1001-5000': '1001-5000',\n    '5001-10000': '5000+', '10001+': '5000+', '10,001+': '5000+'\n  };\n  range = map[range] || null;\n}\n\nconst fieldsUpdated = ['employee_checked_at'];\nif (range) {\n  fieldsUpdated.push('company_size');\n  fieldsUpdated.push('employee_source');\n}\nif (exact) fieldsUpdated.push('employee_count_exact');\n\nreturn {\n  record_id: vendor.id,\n  company_size: range,\n  employee_count_exact: exact,\n  employee_source: source,\n  employee_checked_at: new Date().toISOString(),\n  status: range ? 'success' : 'partial',\n  fields_updated: fieldsUpdated,\n  note: range ? null : 'Could not determine employee count'\n};"
      },
