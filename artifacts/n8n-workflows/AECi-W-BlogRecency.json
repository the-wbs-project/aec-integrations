    {
      "parameters": {
        "jsCode": "const blogUrl = $('Extract Blog URL').first().json.blog_url;\nconst response = $input.first().json;\nconst html = response.data || '';\n\n// Parse <link> tags for RSS/Atom feeds\nconst linkTags = html.match(/<link[^>]+>/gi) || [];\nlet rssFromTag = null;\n\nfor (const tag of linkTags) {\n  if (/type\\s*=\\s*[\"']application\\/(rss|atom)\\+xml[\"']/i.test(tag)) {\n    const hrefMatch = tag.match(/href\\s*=\\s*[\"']([^\"']+)[\"']/i);\n    if (hrefMatch) {\n      rssFromTag = hrefMatch[1];\n      break;\n    }\n  }\n}\n\nconst candidates = [];\n\nif (rssFromTag) {\n  // Resolve relative URL\n  let fullUrl = rssFromTag;\n  if (rssFromTag.startsWith('/')) {\n    try {\n      const base = new URL(blogUrl);\n      fullUrl = base.origin + rssFromTag;\n    } catch (e) {}\n  } else if (!rssFromTag.startsWith('http')) {\n    fullUrl = blogUrl.replace(/\\/+$/, '') + '/' + rssFromTag;\n  }\n  candidates.push({ rss_url: fullUrl, source: 'link_tag' });\n} else {\n  // Try common RSS paths\n  const base = blogUrl.replace(/\\/+$/, '');\n  let origin;\n  try { origin = new URL(blogUrl).origin; } catch (e) { origin = base; }\n\n  const paths = [\n    origin + '/feed/',\n    origin + '/feed',\n    base + '/feed/',\n    base + '/feed',\n    origin + '/blog/feed/',\n    origin + '/blog/feed',\n    base + '/rss',\n    base + '/rss.xml',\n    base + '/feed.xml',\n    base + '/atom.xml',\n    origin + '/feed.xml',\n    origin + '/rss'\n  ];\n\n  // Deduplicate\n  const seen = new Set();\n  for (const p of paths) {\n    if (!seen.has(p)) {\n      seen.add(p);\n      candidates.push({ rss_url: p, source: 'common_path' });\n    }\n  }\n}\n\nreturn candidates;"
      },
      "id": "78e25ba7-1e33-4500-b750-59bd45d3d14c",
      "name": "Discover RSS Candidates",
      "type": "n8n-nodes-base.code",
