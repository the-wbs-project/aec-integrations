        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"blog_rss_url\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"URL of the working RSS/Atom feed, or null if date was extracted from HTML\"\n    },\n    \"latest_post_date\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Most recent post date in YYYY-MM-DD format, or null if not found\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\"high\", \"medium\", \"low\"],\n      \"description\": \"high = clear RSS date, medium = date from HTML, low = uncertain\"\n    },\n    \"notes\": {\n      \"type\": \"string\",\n      \"description\": \"Brief explanation of how the date was determined\"\n    }\n  },\n  \"required\": [\"blog_rss_url\", \"latest_post_date\", \"confidence\", \"notes\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
