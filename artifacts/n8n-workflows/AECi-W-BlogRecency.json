    {
      "parameters": {
        "jsCode": "const vendor = $('Get Vendor Record').first().json;\nconst response = $input.first().json;\nconst body = response.data || '';\nconst rssUrl = vendor.blog_rss_url;\n\nif (typeof body !== 'string' || body.length < 50 || !/<(rss|feed|channel)[\\s>]/i.test(body)) {\n  return { valid: false };\n}\n\nconst datePatterns = [\n  /<pubDate>([^<]+)<\\/pubDate>/gi,\n  /<published>([^<]+)<\\/published>/gi,\n  /<updated>([^<]+)<\\/updated>/gi,\n  /<dc:date>([^<]+)<\\/dc:date>/gi\n];\n\nlet bestDate = null;\nlet bestDateObj = null;\n\nfor (const pattern of datePatterns) {\n  let match;\n  while ((match = pattern.exec(body)) !== null) {\n    const d = new Date(match[1].trim());\n    if (!isNaN(d.getTime())) {\n      if (!bestDateObj || d > bestDateObj) {\n        bestDateObj = d;\n        bestDate = d.toISOString().split('T')[0];\n      }\n    }\n  }\n}\n\nif (bestDate) {\n  return {\n    valid: true,\n    blog_url: vendor.blog_url,\n    blog_rss_url: rssUrl,\n    latest_post_date: bestDate,\n    confidence: 'high',\n    notes: 'Date from stored RSS feed'\n  };\n} else {\n  return { valid: false };\n}"
      },
