    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst vendor = $('Get Vendor Record').first().json;\n\n// Handle different input shapes:\n// - From stored RSS path: {blog_url, blog_rss_url, latest_post_date, ...}\n// - From agent path: {output: {blog_rss_url, latest_post_date, confidence, notes}}\n// - From no-blog path: {blog_url: null, ...}\nlet parsed;\nif (raw.output && typeof raw.output === 'object') {\n  parsed = raw.output;\n} else {\n  parsed = raw;\n}\n\n// Resolve blog_url from available sources\nlet blogUrl = parsed.blog_url || null;\nif (!blogUrl) {\n  try { blogUrl = $('Extract Blog URL').first().json.blog_url; } catch (e) {}\n}\nif (!blogUrl) {\n  blogUrl = vendor.blog_url || null;\n}\n\nlet blogRssUrl = parsed.blog_rss_url || null;\nlet dateStr = null;\nlet daysAgo = null;\n\nif (parsed.latest_post_date && /^\\d{4}-\\d{2}-\\d{2}$/.test(parsed.latest_post_date)) {\n  dateStr = parsed.latest_post_date;\n  const d = new Date(dateStr + 'T00:00:00Z').getTime();\n  if (!isNaN(d)) {\n    daysAgo = Math.floor((Date.now() - d) / 86400000);\n    if (daysAgo < 0) daysAgo = 0;\n    if (daysAgo > 3650) daysAgo = 3650;\n  }\n}\n\nconst noBlog = !blogUrl;\n\nreturn {\n  record_id: vendor.id,\n  blog_url: blogUrl,\n  blog_rss_url: blogRssUrl,\n  blog_last_post_date: dateStr,\n  blog_last_post_days_ago: daysAgo,\n  blog_checked_at: new Date().toISOString(),\n  status: noBlog ? 'success' : (daysAgo !== null ? 'success' : 'partial'),\n  fields_updated: blogUrl\n    ? ['blog_url','blog_rss_url','blog_last_post_date','blog_last_post_days_ago','blog_checked_at']\n    : ['blog_checked_at'],\n  note: noBlog ? 'No blog found for this vendor' : (parsed.notes || null)\n};"
      },
      "id": "77076d56-a244-405a-9b38-333bec8b8c52",
      "name": "Build Result",
