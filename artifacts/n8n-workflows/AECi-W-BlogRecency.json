    {
      "parameters": {
        "jsCode": "return {\n  blog_url: null,\n  blog_rss_url: null,\n  latest_post_date: null,\n  confidence: 'high',\n  notes: 'No blog found for this vendor',\n  needs_ai: false\n};"
      },
      "id": "72d0a92c-0e4e-4d33-b1d6-d0f74a93e484",
      "name": "No Blog Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
