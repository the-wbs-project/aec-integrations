    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"funding_stage\": {\n      \"type\": \"string\",\n      \"enum\": [\"Bootstrapped\", \"Pre-seed\", \"Seed\", \"Series A\", \"Series B\", \"Series C\", \"Series D+\", \"Public\", \"Acquired\", \"Unknown\"],\n      \"description\": \"The company's funding stage\"\n    },\n    \"total_funding_usd\": {\n      \"type\": [\"number\", \"null\"],\n      \"description\": \"Total funding raised in USD, or null if unknown\"\n    },\n    \"last_funding_date\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Date of most recent round in YYYY-MM-DD format, or null\"\n    },\n    \"source_url\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"URL where funding info was found, or null\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\"high\", \"medium\", \"low\"],\n      \"description\": \"Confidence in the funding data\"\n    },\n    \"notes\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"Brief notes (e.g. acquirer name, lead investor)\"\n    }\n  },\n  \"required\": [\"funding_stage\", \"total_funding_usd\", \"last_funding_date\", \"source_url\", \"confidence\", \"notes\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -720,
        384
      ],
      "id": "94b1ebfc-e98a-4af8-b18a-8d29a1b06dc1",
      "name": "Funding Data Parser"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst vendor = $('Get Vendor Record').first().json;\nconst parsed = raw.output || raw;\n\nconst VALID_STAGES = ['Bootstrapped', 'Pre-seed', 'Seed', 'Series A', 'Series B', 'Series C', 'Series D+', 'Public', 'Acquired', 'Unknown'];\n\nconst stage = VALID_STAGES.includes(parsed.funding_stage) ? parsed.funding_stage : 'Unknown';\n\n// Validate date format\nlet lastDate = null;\nif (parsed.last_funding_date && /^\\d{4}-\\d{2}-\\d{2}$/.test(parsed.last_funding_date)) {\n  lastDate = parsed.last_funding_date;\n}\n\n// Validate total funding\nconst totalFunding = (typeof parsed.total_funding_usd === 'number' && parsed.total_funding_usd > 0)\n  ? parsed.total_funding_usd : null;\n\nconst confidence = parsed.confidence || 'low';\nconst low = confidence === 'low' || stage === 'Unknown';\n\nconst fieldsUpdated = ['funding_checked_at'];\nif (stage !== 'Unknown') fieldsUpdated.push('funding_stage');\nif (totalFunding) fieldsUpdated.push('total_funding_usd');\nif (lastDate) fieldsUpdated.push('last_funding_date');\nif (parsed.source_url) fieldsUpdated.push('funding_source_url');\n\nreturn {\n  record_id: vendor.id,\n  funding_stage: stage,\n  total_funding_usd: totalFunding,\n  last_funding_date: lastDate,\n  funding_source_url: parsed.source_url || null,\n  funding_checked_at: new Date().toISOString(),\n  status: low ? 'partial' : 'success',\n  fields_updated: fieldsUpdated,\n  note: parsed.notes || null\n};"
      },
