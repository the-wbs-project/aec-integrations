      "parameters": {
        "jsCode": "const vendor = $('Get Vendor Record').first().json;\n\nreturn {\n  record_id: vendor.id,\n  funding_stage: 'Public',\n  total_funding_usd: null,\n  last_funding_date: null,\n  funding_source_url: null,\n  funding_checked_at: new Date().toISOString(),\n  status: 'success',\n  fields_updated: ['funding_stage', 'funding_checked_at'],\n  note: 'Stage inferred from existing public_private field'\n};"
      },
      "id": "bef73e34-e629-417f-a0b3-3cbf1b761b2a",
      "name": "Skip to Public",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
