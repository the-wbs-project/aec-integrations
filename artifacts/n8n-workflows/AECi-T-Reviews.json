        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst parsed = raw.output || raw;\nconst context = $('Normalize Input').first().json;\nreturn [{ json: {\n  record_id: context.record_id,\n  g2_review_count: typeof parsed.g2_review_count === 'number' ? parsed.g2_review_count : null,\n  g2_rating: typeof parsed.g2_rating === 'number' ? Math.round(parsed.g2_rating * 10) / 10 : null,\n  g2_url: parsed.g2_url || null,\n  capterra_review_count: typeof parsed.capterra_review_count === 'number' ? parsed.capterra_review_count : null,\n  capterra_rating: typeof parsed.capterra_rating === 'number' ? Math.round(parsed.capterra_rating * 10) / 10 : null,\n  capterra_url: parsed.capterra_url || null,\n  reviews_checked_at: new Date().toISOString(),\n  status: 'success',\n  fields_updated: ['g2_review_count', 'g2_rating', 'g2_url', 'capterra_review_count', 'capterra_rating', 'capterra_url', 'reviews_checked_at']\n} }];"
      },
