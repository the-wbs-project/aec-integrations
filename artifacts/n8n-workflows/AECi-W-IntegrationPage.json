    {
      "parameters": {
        "jsCode": "const responses = $input.all().map(i => i.json);\nconst context = $('Normalize Input').item.json;\n\nconst valid = responses.find(r =>\n  r.statusCode === 200 &&\n  typeof r.data === 'string' &&\n  r.data.length > 2000\n);\n\nif (!valid) {\n  return { ...context, found: false };\n}\n\n// Strip scripts and styles to reduce token load for Claude\nconst cleanHtml = valid.data\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n  .substring(0, 12000);\n\nreturn {\n  ...context,\n  found: true,\n  matched_url: valid.url || valid.headers?.['content-location'] || '',\n  page_html: cleanHtml\n};"
      },
      "id": "859511f5-b811-42da-ae49-c356fe820af4",
