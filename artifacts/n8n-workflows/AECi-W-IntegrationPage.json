    {
      "parameters": {
        "jsCode": "const context = $('Normalize Input').item.json;\nconst paths = [\n  '/integrations','/integration','/partners','/partner',\n  '/marketplace','/apps','/app-marketplace','/ecosystem','/connect'\n];\n\nreturn paths.map(p => ({\n  json: {\n    ...context,\n    candidate_path: p,\n    candidate_url: `https://${context.vendor_domain}${p}`\n  }\n}));"
      },
      "id": "acb19538-4e92-4811-aca5-8c53d3f7bab8",
      "name": "Build Candidate URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1088,
        -68
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.candidate_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (compatible; AEC-Integrations-Bot/1.0; +https://aec-integrations.com)"
            },
            {
              "name": "Accept-Language",
              "value": "en-US,en;q=0.9"
            }
          ]
        },
        "options": {
