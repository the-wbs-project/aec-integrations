    {
      "parameters": {
        "promptType": "define",
        "text": "=This is HTML from {{ $json.matched_url }} on vendor {{ $json.company_name }}.\n\nTask: determine if this is a legitimate integrations/partners listing page (not a generic marketing page), and if so, count the distinct third-party integration partners listed.\n\nHTML (cleaned, scripts/styles removed):\n{{ $json.page_html }}\n\nReturn JSON:\n{\n  \"is_integrations_page\": true | false,\n  \"partner_count\": number,\n  \"confidence\": \"low\" | \"medium\" | \"high\",\n  \"notes\": \"brief\"\n}\n\nSet is_integrations_page=false for press pages, customer logos, \"our investors\" etc. Only count distinct integration partners, not case studies or testimonials.",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -1072,
        0
      ],
      "id": "6f866322-d447-49d7-a72c-41e5644d75ba",
      "name": "Claude: Validate & Extract"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"is_integrations_page\": true,\n  \"partner_count\": 42,\n  \"confidence\": \"high\",\n  \"notes\": \"clean partner grid\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -944,
        224
      ],
      "id": "201dcc34-d0d3-4905-a487-13a721026670",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const parsed = $input.item.json.output || $input.item.json;\nconst context = $('Normalize Input').item.json;\nconst matched = $('Pick First Valid Response').item.json;\n\nconst isPage = parsed.is_integrations_page === true && parsed.confidence !== 'low';\n\nreturn {\n  record_id: context.record_id,\n  has_integration_page: isPage,\n  integration_page_url: isPage ? matched.matched_url : null,\n  self_reported_partner_count: isPage ? (parsed.partner_count || 0) : null,\n  integration_page_checked_at: new Date().toISOString(),\n  status: 'success',\n  fields_updated: ['has_integration_page','integration_page_url','self_reported_partner_count','integration_page_checked_at'],\n  note: isPage ? null : (parsed.notes || 'No valid integrations page found')\n};"
      },
      "id": "facb864c-7931-4349-9c97-03b16397a079",
      "name": "Merge Extracted",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const context = $('Normalize Input').item.json;\n\nreturn {\n  record_id: context.record_id,\n  has_integration_page: false,\n  integration_page_url: null,\n  self_reported_partner_count: null,\n  integration_page_checked_at: new Date().toISOString(),\n  status: 'success',\n  fields_updated: ['has_integration_page','integration_page_checked_at'],\n  note: 'No integrations page found at common paths'\n};"
      },
      "id": "971697ae-e318-401f-ba23-9ecb3daf9744",
      "name": "Write Empty Result",
