    {
      "parameters": {
        "jsCode": "const context = $('Normalize Input').item.json;\n\nreturn {\n  record_id: context.record_id,\n  has_integration_page: false,\n  integration_page_url: null,\n  self_reported_partner_count: null,\n  integration_page_checked_at: new Date().toISOString(),\n  status: 'error',\n  fields_updated: ['integration_page_checked_at'],\n  error: `Missing required fields on vendor record (company_name and/or website). record_id=${context.record_id}`\n};"
      },
