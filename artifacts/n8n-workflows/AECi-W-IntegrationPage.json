      "id": "d8b4ef1c-20ca-4c16-b69d-439b7d128232",
      "name": "Check URLs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -1744,
        128
      ],
      "alwaysOutputData": true,
      "credentials": {
