        }
      },
      "id": "c7144ad5-45ac-4256-a5b1-9540a0111f6b",
      "name": "Check URLs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -864,
        -68
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const responses = $input.all().map(i => i.json);\nconst context = $('Normalize Input').item.json;\n\nconst valid = responses.find(r =>\n  r.statusCode === 200 &&\n  typeof r.data === 'string' &&\n  r.data.length > 2000\n);\n\nif (!valid) {\n  return { ...context, found: false };\n}\n\n// Strip scripts and styles to reduce token load for Claude\nconst cleanHtml = valid.data\n  .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n  .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n  .substring(0, 8000);\n\nreturn {\n  ...context,\n  found: true,\n  matched_url: valid.url || valid.headers?.['content-location'] || '',\n  page_html: cleanHtml\n};"
      },
      "id": "590dad33-1d19-4e16-9cf5-6f1989b8d19a",
      "name": "Pick First Valid Response",
