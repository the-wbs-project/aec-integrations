    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"platforms\": {\n      \"type\": \"array\",\n      \"items\": { \"type\": \"string\", \"enum\": [\"Zapier\", \"Make\", \"Workato\"] },\n      \"description\": \"List of iPaaS platforms where the tool was found\"\n    },\n    \"zapier_trigger_count\": {\n      \"type\": \"integer\",\n      \"description\": \"Number of Zapier triggers and actions (0 if not found on Zapier)\"\n    },\n    \"details\": {\n      \"type\": \"object\",\n      \"description\": \"Additional details per platform\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\"high\", \"medium\", \"low\"],\n      \"description\": \"Confidence level\"\n    }\n  },\n  \"required\": [\"platforms\", \"confidence\"]\n}"
      },
      "id": "a7a86857-0463-494e-aabb-eb1de7d1671a",
      "name": "Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1376,
        224
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst parsed = raw.output || raw;\nconst context = $('Normalize Input').first().json;\nconst validNames = ['Zapier', 'Make', 'Workato'];\nconst platforms = (parsed.platforms || []).filter(p => validNames.includes(p));\nconst zapierCount = typeof parsed.zapier_trigger_count === 'number' ? parsed.zapier_trigger_count : null;\nreturn [{ json: {\n  record_id: context.record_id,\n  ipaas_platforms: platforms.length > 0 ? platforms : null,\n  ipaas_count: platforms.length,\n  zapier_trigger_count: zapierCount,\n  ipaas_checked_at: new Date().toISOString(),\n  status: 'success',\n  fields_updated: ['ipaas_platforms', 'ipaas_count', 'zapier_trigger_count', 'ipaas_checked_at'],\n  note: platforms.length > 0 ? `Found on: ${platforms.join(', ')}` : 'No iPaaS listings found'\n} }];"
      },
