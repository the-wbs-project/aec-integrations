    {
      "parameters": {
        "promptType": "define",
        "text": "=Is '{{ $('Normalize Input').first().json.company_name }}' a distinctive company name, or does it overlap with common words, other companies, or unrelated entities?\n\nReturn JSON:\n{\n  \"is_distinctive\": true | false,\n  \"suggested_query\": \"query string\"\n}\n\nIf distinctive, suggested_query = company name in double quotes.\nIf ambiguous, suggested_query = company name in quotes plus a disambiguating qualifier that reflects the AEC/construction software context, e.g. \"Sage construction software\" or \"Bentley Systems engineering\".\n\nUse quotes around the company name to force exact match.",
        "hasOutputParser": true
      },
      "id": "2a427303-9a62-490c-89d2-64b8d5ced23c",
      "name": "Is Name Distinctive?",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        2976,
        -256
      ]
    },
    {
      "parameters": {
        "model": {
