    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"is_distinctive\": {\n      \"type\": \"boolean\",\n      \"description\": \"Whether the company name is distinctive enough for unambiguous search\"\n    },\n    \"suggested_query\": {\n      \"type\": \"string\",\n      \"description\": \"Search query string with company name in quotes, plus optional disambiguator\"\n    }\n  },\n  \"required\": [\"is_distinctive\", \"suggested_query\"]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        3112,
        -32
      ],
      "id": "8701c786-e2a7-4b2f-9811-7c4790cc5766",
      "name": "Distinctiveness Parser"
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst parsed = raw.output || raw;\nconst context = $('Normalize Input').first().json;\n\nconst query = parsed.suggested_query || `\"${context.company_name}\"`;\nconst encoded = encodeURIComponent(query);\n\nreturn {\n  ...context,\n  google_news_url: `https://news.google.com/rss/search?q=${encoded}&hl=en-US&gl=US&ceid=US:en&when=1y`,\n  query_used: query\n};"
      },
      "id": "7a653fbc-3da1-4fa6-b3ad-f842d6382340",
      "name": "Build Google News Query",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3328,
        -256
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.google_news_url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "Mozilla/5.0 (compatible; AEC-Integrations-Bot/1.0; +https://aec-integrations.com)"
            },
            {
              "name": "Accept-Language",
              "value": "en-US,en;q=0.9"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
