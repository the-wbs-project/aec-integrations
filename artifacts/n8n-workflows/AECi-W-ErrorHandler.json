        "jsCode": "const parsed = $('Parse Error Payload').item.json;\nconst recordId = parsed.record_id;\n\nif (!recordId) {\n  return { skip: true };\n}\n\nreturn {\n  record_id: recordId,\n  error_line: `[${parsed.occurred_at}] [${parsed.workflow_name}] [${parsed.node_name}] ${parsed.error_message}`\n};"
