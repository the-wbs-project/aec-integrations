    {
      "parameters": {
        "jsCode": "const vendor = $input.item.json;\nconst fields = vendor.fields || vendor;\nconst updateData = $('Prepare Vendor Update').item.json;\n\nconst existingLog = fields.enrichment_error_log || '';\nconst newEntry = updateData.error_line;\n\nconst lines = (existingLog ? existingLog.split('\\n') : []).concat(newEntry);\nconst trimmed = lines.slice(-20).join('\\n');\n\nreturn {\n  record_id: updateData.record_id,\n  enrichment_error_log: trimmed,\n  needs_manual_review: true\n};"
      },
