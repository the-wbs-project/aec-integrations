{
  "name": "AECi-W-ErrorHandler",
  "nodes": [
    {
      "parameters": {},
      "id": "3a6d8f8d-0121-4ea1-a90c-1f45f537e9ce",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        -800,
        176
      ]
    },
    {
      "parameters": {
        "jsCode": "const err = $input.item.json;\nconst execution = err.execution || {};\nconst workflow = err.workflow || {};\n\n// Error details\nconst errorObj = execution.error || {};\nconst errorMessage = errorObj.message || 'Unknown error';\nconst errorStack = errorObj.stack || '';\nconst nodeName = errorObj.node?.name || 'unknown';\n\n// Extract record_id and vendor_name by walking the execution data\nlet recordId = null;\nlet vendorName = null;\ntry {\n  const runData = execution.data?.resultData?.runData || {};\n  for (const [nName, runs] of Object.entries(runData)) {\n    if (!runs || !runs.length) continue;\n    const lastRun = runs[runs.length - 1];\n    const items = lastRun?.data?.main?.[0] || [];\n    for (const item of items) {\n      const json = item?.json || {};\n      if (!recordId && typeof json.record_id === 'string' && json.record_id.startsWith('rec')) {\n        recordId = json.record_id;\n      }\n      if (!vendorName && typeof json.company_name === 'string') {\n        vendorName = json.company_name;\n      }\n      if (recordId && vendorName) break;\n    }\n    if (recordId && vendorName) break;\n  }\n} catch (e) {}\n\n// Classify error type from message\nlet errorType = 'unknown';\nconst msg = errorMessage.toLowerCase();\nif (msg.includes('401') || msg.includes('403') || msg.includes('unauthorized') || msg.includes('forbidden')) {\n  errorType = 'auth_error';\n} else if (msg.includes('429') || msg.includes('rate limit')) {\n  errorType = 'rate_limit';\n} else if (msg.includes('timeout') || msg.includes('etimedout')) {\n  errorType = 'timeout';\n} else if (msg.includes('parse') || msg.includes('json') || msg.includes('unexpected token')) {\n  errorType = 'parse_error';\n} else if (msg.match(/\\b[45]\\d\\d\\b/)) {\n  errorType = 'http_error';\n} else if (msg.includes('missing') || msg.includes('undefined') || msg.includes('null')) {\n  errorType = 'missing_data';\n}\n\n// Classify severity\nlet severity = 'error';\nif (errorType === 'auth_error') severity = 'critical';\nelse if (errorType === 'rate_limit') severity = 'warning';\n\nconst workflowName = workflow.name || 'Other';\nconst occurredAt = new Date().toISOString();\nconst errorRef = `${workflowName}/${recordId || 'no-record'}/${occurredAt}`;\n\nreturn {\n  error_ref: errorRef,\n  occurred_at: occurredAt,\n  workflow_name: workflowName,\n  workflow_execution_id: execution.id || '',\n  record_id: recordId,\n  vendor_name: vendorName,\n  node_name: nodeName,\n  error_type: errorType,\n  error_message: errorMessage,\n  error_stack: errorStack.substring(0, 4000),\n  severity\n};"
      },
