    {
      "parameters": {
        "jsCode": "let trendsRaw = null;\nlet searchRaw = null;\ntry { trendsRaw = $('Google Trends Request').all()[0]?.json; } catch (e) {}\ntry { searchRaw = $('Search Volume Request').all()[0]?.json; } catch (e) {}\nconst context = $('Normalize Input').first().json;\n\nlet trendsIndex = null;\ntry {\n  const data = trendsRaw?.data || trendsRaw;\n  const timelines = data?.interest_over_time?.timeline_data;\n  if (Array.isArray(timelines) && timelines.length > 0) {\n    const values = timelines.map(t => t.values?.[0]?.extracted_value || 0);\n    trendsIndex = Math.round(values.reduce((a, b) => a + b, 0) / values.length);\n  }\n} catch (e) {}\n\nlet searchVolume = null;\ntry {\n  const data = searchRaw?.data || searchRaw;\n  const totalResults = data?.search_information?.total_results;\n  if (totalResults && totalResults > 0) {\n    searchVolume = Math.round(Math.log10(totalResults + 1) * 100);\n  }\n} catch (e) {}\n\nreturn {\n  record_id: context.record_id,\n  search_volume_monthly: searchVolume,\n  google_trends_index: trendsIndex,\n  search_checked_at: new Date().toISOString(),\n  status: (trendsIndex !== null || searchVolume !== null) ? 'success' : 'partial',\n  fields_updated: ['search_volume_monthly', 'google_trends_index', 'search_checked_at'],\n  note: (trendsIndex === null && searchVolume === null) ? 'No search demand data available' : null\n};"
      },
