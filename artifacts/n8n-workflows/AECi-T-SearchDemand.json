      "id": "a6000001-0008-4000-a000-000000000008",
      "name": "Search Volume Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        400
      ],
      "alwaysOutputData": true,
      "credentials": {
        "httpBearerAuth": {
          "id": "svEdy4ASukdpjdOg",
          "name": "SERP Cache Bearer"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const trendsRaw = $('Google Trends Request').first().json;\nconst searchRaw = $('Search Volume Request').first().json;\nconst context = $('Normalize Input').item.json;\n\nlet trendsIndex = null;\ntry {\n  const data = trendsRaw.data || trendsRaw;\n  const timelines = data?.interest_over_time?.timeline_data;\n  if (Array.isArray(timelines) && timelines.length > 0) {\n    const values = timelines.map(t => t.values?.[0]?.extracted_value || 0);\n    trendsIndex = Math.round(values.reduce((a, b) => a + b, 0) / values.length);\n  }\n} catch (e) {}\n\nlet searchVolume = null;\ntry {\n  const data = searchRaw.data || searchRaw;\n  const totalResults = data?.search_information?.total_results;\n  if (totalResults && totalResults > 0) {\n    searchVolume = Math.round(Math.log10(totalResults + 1) * 100);\n  }\n} catch (e) {}\n\nreturn {\n  record_id: context.record_id,\n  search_volume_monthly: searchVolume,\n  google_trends_index: trendsIndex,\n  search_checked_at: new Date().toISOString(),\n  status: (trendsIndex !== null || searchVolume !== null) ? 'success' : 'partial',\n  fields_updated: ['search_volume_monthly', 'google_trends_index', 'search_checked_at'],\n  note: (trendsIndex === null && searchVolume === null) ? 'No search demand data available' : null\n};"
      },
      "id": "a6000001-0009-4000-a000-000000000009",
      "name": "Parse Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
