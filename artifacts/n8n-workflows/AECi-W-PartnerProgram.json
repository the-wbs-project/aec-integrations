      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"is_formal_partner_program\": {\n      \"type\": \"boolean\",\n      \"description\": \"Whether this is a formal partner program with tiers, application process, or partner benefits\"\n    },\n    \"partner_has_application\": {\n      \"type\": \"boolean\",\n      \"description\": \"Whether the partner program has an application process\"\n    },\n    \"is_affiliate_program\": {\n      \"type\": \"boolean\",\n      \"description\": \"Whether an affiliate or referral program exists offering commission or revenue share\"\n    },\n    \"confidence\": {\n      \"type\": \"string\",\n      \"enum\": [\"high\", \"medium\", \"low\"]\n    },\n    \"notes\": {\n      \"type\": \"string\",\n      \"description\": \"Brief explanation of classification\"\n    }\n  },\n  \"required\": [\"is_formal_partner_program\", \"partner_has_application\", \"is_affiliate_program\", \"confidence\", \"notes\"]\n}"
      },
