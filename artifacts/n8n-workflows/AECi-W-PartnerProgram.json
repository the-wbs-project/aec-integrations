    {
      "parameters": {
        "jsCode": "const responses = $input.all().map(i => i.json);\nconst context = $('Normalize Input').first().json;\n\nconst partnerMatch = responses.find(r =>\n  r.statusCode === 200 &&\n  typeof r.data === 'string' &&\n  r.data.length > 2000 &&\n  r.candidate_kind === 'partner'\n);\n\nconst affiliateMatch = responses.find(r =>\n  r.statusCode === 200 &&\n  typeof r.data === 'string' &&\n  r.data.length > 2000 &&\n  r.candidate_kind === 'affiliate'\n);\n\nfunction clean(html) {\n  return html\n    .replace(/<script[\\s\\S]*?<\\/script>/gi, '')\n    .replace(/<style[\\s\\S]*?<\\/style>/gi, '')\n    .substring(0, 8000);\n}\n\nreturn {\n  ...context,\n  partner_page_found: !!partnerMatch,\n  partner_page_url: partnerMatch?.candidate_url || null,\n  partner_page_html: partnerMatch ? clean(partnerMatch.data) : null,\n  affiliate_page_found: !!affiliateMatch,\n  affiliate_page_url: affiliateMatch?.candidate_url || null,\n  affiliate_page_html: affiliateMatch ? clean(affiliateMatch.data) : null,\n  any_page_found: !!(partnerMatch || affiliateMatch)\n};"
      },
