{
  "title": "AECi Phase 3 — Search",
  "description": "Phase 3 search observability (AECI-141). Worker-side Algolia sync health from the API Worker (aeci-api): aeci.algolia.sync (count, outcome), aeci.algolia.sync.records (count — query with sum:, the value is the record count not 1), aeci.algolia.sync.duration_ms (distribution — enable percentile aggregations under Metrics > Summary), and the AECI-140 aeci.algolia.index_drift gauge. NOTE: Datadog lowercases tag values (outcome queried as ok/failed). Browser-side Algolia query latency + error rate (aeci.search.query RUM action, §14.3) is deferred until a search-results UI exists to instrument — its two widgets land with that issue; contract in docs/OBSERVABILITY.md. Committed for record (AECI-141); the live dashboard is the source of truth — re-export after edits.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": ["staging", "production"],
      "default": "production"
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Algolia sync runs by outcome",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "name": "runs",
                "data_source": "metrics",
                "query": "count:aeci.algolia.sync{$env} by {outcome}"
              }
            ],
            "formulas": [{ "formula": "runs" }]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Algolia sync runs by entity and trigger",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "name": "runs",
                "data_source": "metrics",
                "query": "count:aeci.algolia.sync{$env} by {entity,trigger}"
              }
            ],
            "formulas": [{ "formula": "runs" }]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Sync duration — p50 / p95 / p99 (by trigger)",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "p50",
                "data_source": "metrics",
                "query": "p50:aeci.algolia.sync.duration_ms{$env} by {trigger}"
              }
            ],
            "formulas": [{ "formula": "p50", "alias": "p50" }]
          },
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "p95",
                "data_source": "metrics",
                "query": "p95:aeci.algolia.sync.duration_ms{$env} by {trigger}"
              }
            ],
            "formulas": [{ "formula": "p95", "alias": "p95" }]
          },
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "p99",
                "data_source": "metrics",
                "query": "p99:aeci.algolia.sync.duration_ms{$env} by {trigger}"
              }
            ],
            "formulas": [{ "formula": "p99", "alias": "p99" }]
          }
        ],
        "yaxis": { "label": "ms" }
      }
    },
    {
      "definition": {
        "title": "Records pushed per entity (saved / deleted)",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "name": "records",
                "data_source": "metrics",
                "query": "sum:aeci.algolia.sync.records{$env} by {entity,op}"
              }
            ],
            "formulas": [{ "formula": "records" }]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Index drift per index (Supabase − Algolia, AECI-140)",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "drift",
                "data_source": "metrics",
                "query": "max:aeci.algolia.index_drift{$env} by {index}"
              }
            ],
            "formulas": [{ "formula": "drift" }]
          }
        ],
        "markers": [{ "value": "y = 0", "display_type": "ok dashed", "label": "in sync" }]
      }
    }
  ]
}
