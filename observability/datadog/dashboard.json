{
  "title": "AECi Phase 2 — Traffic",
  "description": "Phase 2 traffic observability (AECI-66). Custom metrics emitted by the SSR Worker (aeci-web) and API Worker (aeci-api): aeci.page.render.duration_ms, aeci.api.query.duration_ms, aeci.cache.purge. NOTE: Datadog lowercases tag values, so cache_status is queried as hit/miss. Distribution metrics require percentile aggregations enabled under Metrics > Summary. Committed for record (AECI-66); the live dashboard is the source of truth — re-export after edits.",
  "layout_type": "ordered",
  "reflow_type": "fixed",
  "template_variables": [
    {
      "name": "env",
      "prefix": "env",
      "available_values": ["staging", "production"],
      "default": "production"
    }
  ],
  "widgets": [
    {
      "definition": {
        "title": "Top routes by request count (SSR route_class)",
        "type": "toplist",
        "requests": [
          {
            "response_format": "scalar",
            "queries": [
              {
                "name": "q",
                "data_source": "metrics",
                "query": "count:aeci.page.render.duration_ms{$env} by {route_class}",
                "aggregator": "sum"
              }
            ],
            "formulas": [{ "formula": "q", "limit": { "count": 10, "order": "desc" } }]
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Cache hit rate per route_class (HIT / total)",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "hits",
                "data_source": "metrics",
                "query": "count:aeci.page.render.duration_ms{$env,cache_status:hit} by {route_class}"
              },
              {
                "name": "total",
                "data_source": "metrics",
                "query": "count:aeci.page.render.duration_ms{$env} by {route_class}"
              }
            ],
            "formulas": [{ "formula": "hits / total * 100", "alias": "hit rate %" }]
          }
        ],
        "yaxis": { "min": "0", "max": "100" },
        "markers": [
          { "value": "y = 70", "display_type": "error dashed", "label": "alert threshold" }
        ]
      }
    },
    {
      "definition": {
        "title": "Page render duration per route_class — p50 / p95 / p99",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "p50",
                "data_source": "metrics",
                "query": "p50:aeci.page.render.duration_ms{$env} by {route_class}"
              }
            ],
            "formulas": [{ "formula": "p50", "alias": "p50" }]
          },
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "p95",
                "data_source": "metrics",
                "query": "p95:aeci.page.render.duration_ms{$env} by {route_class}"
              }
            ],
            "formulas": [{ "formula": "p95", "alias": "p95" }]
          },
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "p99",
                "data_source": "metrics",
                "query": "p99:aeci.page.render.duration_ms{$env} by {route_class}"
              }
            ],
            "formulas": [{ "formula": "p99", "alias": "p99" }]
          }
        ],
        "yaxis": { "label": "ms" }
      }
    },
    {
      "definition": {
        "title": "p95 API query duration per endpoint",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "p95",
                "data_source": "metrics",
                "query": "p95:aeci.api.query.duration_ms{$env} by {endpoint}"
              }
            ],
            "formulas": [{ "formula": "p95" }]
          }
        ],
        "yaxis": { "label": "ms" }
      }
    },
    {
      "definition": {
        "title": "4xx / 5xx error rate over time (both Workers)",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "line",
            "queries": [
              {
                "name": "r4",
                "data_source": "metrics",
                "query": "count:aeci.page.render.duration_ms{$env,status_class:4xx}"
              },
              {
                "name": "r5",
                "data_source": "metrics",
                "query": "count:aeci.page.render.duration_ms{$env,status_class:5xx}"
              },
              {
                "name": "rt",
                "data_source": "metrics",
                "query": "count:aeci.page.render.duration_ms{$env}"
              },
              {
                "name": "a4",
                "data_source": "metrics",
                "query": "count:aeci.api.query.duration_ms{$env,status_class:4xx}"
              },
              {
                "name": "a5",
                "data_source": "metrics",
                "query": "count:aeci.api.query.duration_ms{$env,status_class:5xx}"
              },
              {
                "name": "at",
                "data_source": "metrics",
                "query": "count:aeci.api.query.duration_ms{$env}"
              }
            ],
            "formulas": [
              { "formula": "(r4 + a4) / (rt + at) * 100", "alias": "4xx rate %" },
              { "formula": "(r5 + a5) / (rt + at) * 100", "alias": "5xx rate %" }
            ]
          }
        ],
        "yaxis": { "label": "%", "min": "0" },
        "markers": [
          { "value": "y = 1", "display_type": "error dashed", "label": "1% alert threshold" }
        ]
      }
    },
    {
      "definition": {
        "title": "Cache purge events by source",
        "type": "timeseries",
        "requests": [
          {
            "response_format": "timeseries",
            "display_type": "bars",
            "queries": [
              {
                "name": "purges",
                "data_source": "metrics",
                "query": "count:aeci.cache.purge{$env} by {source}"
              }
            ],
            "formulas": [{ "formula": "purges" }]
          }
        ]
      }
    }
  ]
}
