diff --git a/dist/compiler.mjs b/dist/compiler.mjs
index 378e428ac843cf823facb492c0a77b9653d83430..fd50a76176f54e8a5799959ca7b6289afc7991f9 100644
--- a/dist/compiler.mjs
+++ b/dist/compiler.mjs
@@ -150,7 +150,21 @@ function isAlwaysCriticalSelector(sel) {
 * matched against the document, since we only care that the associated
 * elements exist.
 */
+function unwrapFunctionalPseudo(sel) {
+	const match = sel.trim().match(/^:(?:where|is)\((.*)\)$/s);
+	if (!match) return sel;
+	let depth = 0;
+	for (const ch of match[1]) {
+		if (ch === "(") depth++;
+		else if (ch === ")" && --depth < 0) return sel;
+	}
+	return depth === 0 ? match[1] : sel;
+}
 function normalizeCssSelector(sel) {
+	// AECI-1854 patch: a selector that is entirely `:where(...)` or `:is(...)`
+	// (Tailwind v4's space-*, divide-* and similar) was stripped to an empty
+	// string and dropped from the critical CSS. Match its argument instead.
+	sel = unwrapFunctionalPseudo(sel);
 	return sel.replace(removePseudoClassesAndElementsPattern, "").replace(removeTrailingCommasPattern, (match) => match.includes("(") ? "(" : ")").replace(implicitUniversalPattern, "$1 * $2").replace(emptyCombinatorPattern, "$1 *").trim();
 }
 //#endregion
